@model company_profile.TestimonialVM
@{
    ViewData["Title"] = "Customer Testimonials";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fa fa-comment"></i> Customer Testimonials</h2>
        <div>
            <select id="langSwitcher" class="form-select form-select-sm d-inline-block w-auto">
                <option value="ID">🇮🇩 ID</option>
                <option value="EN">🇺🇸 EN</option>
            </select>
            <a asp-action="Create" class="btn btn-primary btn-sm ms-2">
                <i class="fa fa-plus"></i> Add Testimonial
            </a>
        </div>
    </div>
    <div id="table-container">
        <partial name="_TestimonialPartial.cshtml" model="Model" />
    </div>    
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Event delegation untuk pagination
            $('#table-container').on('click', 'button.btn:not(.disabled)', function () {
                var targetPage = $(this).data('page');
                $.ajax({
                    url: '@Url.Action("GetPaginatedData", "Testimonial")',
                    data: { pageNumber: targetPage },
                    success: function (result) {
                        $('#table-container').html(result);
                    }
                });
            });
        });
    </script>
    <script>
        // 1. Tambahkan listener agar script berjalan setelah semua elemen HTML siap
                document.addEventListener('DOMContentLoaded', function() {
            const langSwitcher = document.getElementById('langSwitcher');

            langSwitcher.addEventListener('change', function() {
                const lang = this.value;

                // Update Jabatan
                document.querySelectorAll('.text-jabatan').forEach(el => {
                    el.innerText = (lang === 'ID') ? el.getAttribute('data-id') : el.getAttribute('data-en');
                });

                // Update Testimoni
                document.querySelectorAll('.text-testimoni').forEach(el => {
                    el.innerHTML = (lang === 'ID') ? el.getAttribute('data-id') : el.getAttribute('data-en');
                });
            });
        });
    </script>

    <script>
        function deleteTesti(id) {
            Swal.fire({
                title: 'Hapus testimoni?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Ya, Hapus'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Testimonial/Delete/' + id,
                        type: 'POST',
                        success: function (res) { if (res.success) location.reload(); }
                    });
                }
            });
        }

         @if (TempData["SuccessMessage"] != null)
        {
            <text>
                Swal.fire({ icon: 'success', title: 'Berhasil!', text: '@TempData["SuccessMessage"]', position: 'top', timer: 3000, showConfirmButton: false });
            </text>
        }

    </script>
}