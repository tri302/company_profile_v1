@model SpecialFeaturesListViewModel
@using System.Text.RegularExpressions
@using company_profile.PagenationVM

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom">
                    <tr>
                        @* <th class="text-center" style="width: 5%">#</th> *@
                        <th style="width: 30%">Judul</th>
                        <th style="width: 45%">Isi Konten (Preview)</th>
                        <th class="text-center" style="width: 20%">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items != null && Model.Items.Any())
                    {
                        @* int no = 1; *@
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                @* <td class="text-center text-muted">@no</td> *@
                                <td>
                                    <div class="fw-bold text-dark">@item.JudulSpecialFeatures_ID</div>
                                    <div class="mt-1">
                                        <span class="badge bg-light text-danger border me-1 small">ID</span>
                                        <span class="badge bg-light text-primary border small">EN</span>
                                    </div>
                                </td>
                                <td>
                                    @* Gunakan Regex untuk menghapus tag HTML agar tabel rapi *@
                                    <div class="text-truncate" style="max-width: 400px;"
                                         title="@Regex.Replace(item.IsiContentSpecialFeatures_ID ?? "", "<.*?>", String.Empty)">

                                        @* Tampilkan versi bersih untuk tabel *@
                                        @Regex.Replace(item.IsiContentSpecialFeatures_ID ?? "", "<.*?>", String.Empty)
                                    </div>

                                    @* Versi EN dengan pembersihan tag dulu sebelum dipotong agar lebih aman *@
                                    <small class="text-muted fst-italic">
                                        EN: @{
                                            var cleanEn = Regex.Replace(item.IsiContentSpecialFeatures_EN ?? "", "<.*?>", String.Empty);
                                            var displayEn = cleanEn.Length > 50 ? cleanEn.Substring(0, 50) + "..." : cleanEn;
                                        }
                                        @displayEn
                                    </small>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">
                                            <i class="fa fa-edit"></i>
                                            Edit
                                        </a>
                                        <button type="button" onclick="deleteFeature(@item.Id)" class="btn btn-sm btn-danger">
                                            <i class="fa fa-trash"></i>
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            @* no++; *@
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fa fa-folder-open fa-2x mb-3 d-block"></i>
                                Belum ada data tersedia.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-flex justify-content-center align-items-center mt-3 gap-3" id="pagination-controls">
    <button id="btn-prev" class="btn btn-primary btn-sm @(Model.CurrentPage <= 1 ? "disabled" : "")"
            data-page="@(Model.CurrentPage - 1)">
        <i class="fa fa-arrow-left"></i>
        Previous
    </button>

    <span class="text-muted fw-bold">Page @Model.CurrentPage of @Model.TotalPages</span>

    <button id="btn-next" class="btn btn-warning btn-sm @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
            data-page="@(Model.CurrentPage + 1)">
        Next
        <i class="fa fa-arrow-right"></i>
    </button>
</div>