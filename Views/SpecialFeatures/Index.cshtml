@model company_profile.PagenationVM.SpecialFeaturesListViewModel
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "Special Features Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-0 text-dark"><i class="fa fa-star text-warning me-2"></i>Special Features</h4>
            <small class="text-muted">Kelola fitur spesial dengan dukungan multi-bahasa</small>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm btn-sm">
            <i class="fa fa-plus-circle me-1"></i> Create New
        </a>
    </div>

    <div id="table-container">
        <partial name="_SpecialFeaturesPartial" model="Model" />
    </div>

</div>

@section Scripts {

    <script>
        $(document).ready(function () {
            // Event delegation untuk pagination
            $('#table-container').on('click', 'button.btn:not(.disabled)', function () {
                var targetPage = $(this).data('page');
                $.ajax({
                    url: '@Url.Action("GetPaginatedData", "SpecialFeatures")',
                    data: { pageNumber: targetPage },
                    success: function (result) {
                        $('#table-container').html(result);
                    }
                });
            });
        });
    </script>

    <script>
        function deleteFeature(id) {
            Swal.fire({
                title: 'Hapus fitur ini?',
                text: "Data yang dihapus tidak dapat dipulihkan.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Ya, Hapus',
                position: 'top'
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({ title: 'Memproses...', didOpen: () => { Swal.showLoading(); }, position: 'top', showConfirmButton: false });
                    $.ajax({
                        url: '@Url.Action("Delete", "SpecialFeatures")/' + id,
                        type: 'POST',
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({ icon: 'success', title: 'Terhapus!', text: 'Data berhasil dihapus', position: 'top', timer: 2000, showConfirmButton: false }).then(() => { location.reload(); });
                            }
                        }
                    });
                }
            });
        }

        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                    Swal.fire({ icon: 'success', title: 'Berhasil!', text: '@TempData["SuccessMessage"]', position: 'top', timer: 3000, showConfirmButton: false });
            </text>
        }
    </script>
}