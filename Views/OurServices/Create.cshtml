@model company_profile.OurServicesVM
@{
    ViewData["Title"] = "Tambah Layanan Baru";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .ck-editor__editable_inline {
        min-height: 280px;
    }
    .nav-tabs .nav-link {
        color: #495057;
        font-weight: 500;
        transition: all 0.2s ease-in-out;
        border: none;
        border-bottom: 3px solid transparent;
    }
    .nav-tabs .nav-link:hover {
        border-color: transparent;
        color: #0d6efd;
    }
    .nav-tabs .nav-link.active {
        color: #0d6efd;
        background-color: transparent;
        border-color: transparent;
        border-bottom: 3px solid #0d6efd;
        font-semibold: 600;
    }
</style>

<div class="container-fluid px-4 mt-4">
    <!-- Header Modul -->
    <div class="card shadow-sm border-0 rounded-3 mb-4">
        <div class="card-body p-4 bg-white rounded-3">
            <div class="d-flex align-items-center">
                <div class="bg-primary-subtle text-primary p-3 rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 55px; height: 55px;">
                    <i class="fa fa-plus-circle fa-2x" aria-hidden="true"></i>
                </div>
                <div>
                    <h4 class="mb-1 fw-bold text-dark">Tambah Layanan Baru</h4>
                    <p class="text-muted mb-0 small">Formulir publikasi data keunggulan produk dan operasional jasa multi-bahasa.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Input Utama -->
    <form asp-action="Create" enctype="multipart/form-data" method="post" id="formService">
        @Html.AntiForgeryToken()
        
        <div class="row">
            <!-- Kolom Kiri: Input Konten Multibahasa -->
            <div class="col-xl-8 col-lg-7">
                <div class="card shadow-sm border-0 rounded-3 mb-4">
                    <div class="card-body p-4">
                        
                        <!-- Nav Tabs Bahasa -->
                        <ul class="nav nav-tabs mb-4 border-bottom" id="languageTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active d-flex align-items-center gap-2 pb-3" id="id-tab" data-bs-toggle="tab" data-bs-target="#panel-id" type="button" role="tab" aria-controls="panel-id" aria-selected="true">
                                    <span>🇮🇩</span> <strong>Bahasa Indonesia</strong>
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link d-flex align-items-center gap-2 pb-3" id="en-tab" data-bs-toggle="tab" data-bs-target="#panel-en" type="button" role="tab" aria-controls="panel-en" aria-selected="false">
                                    <span>🇬🇧</span> <strong>English (Inggris)</strong>
                                </button>
                            </li>
                        </ul>

                        <!-- Isi Tab Konten -->
                        <div class="tab-content" id="languageTabsContent">
                            
                            <!-- Panel Bahasa Indonesia -->
                            <div class="tab-pane fade show active" id="panel-id" role="tabpanel" aria-labelledby="id-tab">
                                <div class="mb-4">
                                    <label asp-for="JudulService_ID" class="form-label fw-bold text-dark">Nama / Judul Layanan (ID)</label>
                                    <input asp-for="JudulService_ID" class="form-control form-control-solid shadow-sm" placeholder="Contoh: Pengembangan Aplikasi Web" />
                                    <span asp-validation-for="JudulService_ID" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="IsiService_ID" class="form-label fw-bold text-dark">Deskripsi Lengkap Layanan (ID)</label>
                                    <textarea asp-for="IsiService_ID" id="editor_ID" class="form-control"></textarea>
                                    <span asp-validation-for="IsiService_ID" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <!-- Panel Bahasa Inggris -->
                            <div class="tab-pane fade" id="panel-en" role="tabpanel" aria-labelledby="en-tab">
                                <div class="mb-4">
                                    <label asp-for="JudulService_EN" class="form-label fw-bold text-dark">Service Title / Name (EN)</label>
                                    <input asp-for="JudulService_EN" class="form-control form-control-solid shadow-sm" placeholder="e.g., Web Application Development" />
                                    <span asp-validation-for="JudulService_EN" class="text-danger small mt-1 d-block"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="IsiService_EN" class="form-label fw-bold text-dark">Full Service Description (EN)</label>
                                    <textarea asp-for="IsiService_EN" id="editor_EN" class="form-control"></textarea>
                                    <span asp-validation-for="IsiService_EN" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                        </div>

                    </div>
                </div>
            </div>

            <!-- Kolom Kanan: Pengaturan Media & Tombol Aksi -->
            <div class="col-xl-4 col-lg-5">
                <!-- Card Upload Gambar -->
                <div class="card shadow-sm border-0 rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="m-0 fw-bold text-dark"><i class="fa fa-image me-2 text-secondary"></i>Visual Ikon / Gambar</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="preview-container mb-3 border rounded-3 d-flex align-items-center justify-content-center bg-light shadow-inner position-relative" 
                             style="height: 240px; overflow: hidden;">
                            <img id="imgPreview" src="~/uploads/no-image.png" class="img-fluid"
                                 style="max-height: 100%; object-fit: contain;" alt="Preview Thumbnail" />
                        </div>
                        
                        <div class="mb-2">
                            <label class="form-label fw-bold text-dark small">Pilih Berkas Gambar</label>
                            <input asp-for="UploadGambar" id="fileInput" class="form-control shadow-sm" type="file" accept="image/*" required />
                            <span id="imageError" class="text-danger small d-block mt-1"></span>
                            <span asp-validation-for="UploadGambar" class="text-danger small mt-1 d-block"></span>
                        </div>
                        <div class="bg-light p-3 rounded-2 border border-dashed mt-3">
                            <small class="text-muted d-block line-height-sm">
                                <i class="fa fa-info-circle text-primary me-1"></i> <strong>Ketentuan File:</strong> Ukuran beban maksimal <strong>5 MB</strong> dengan ekstensi valid berupa <strong>.jpg, .jpeg, atau .png</strong>.
                            </small>
                        </div>
                    </div>
                </div>

                <!-- Card Tombol Aksi Mandiri -->
                <div class="card shadow-sm border-0 rounded-3">
                    <div class="card-body p-3 bg-light rounded-3">
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fa fa-save me-1"></i> Publish Layanan
                            </button>
                            <a asp-action="Index" class="btn btn-sm btn-secondary">
                                <i class="fa fa-arrow-left me-1"></i> Kembali ke Daftar
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
            // --- LOGIKA CKEDITOR MULTI-BAHASA (ID & EN) ---
            const initCKEditor = (selector, textareaId) => {
                const element = document.querySelector(selector);
                if (element) {
                    ClassicEditor.create(element)
                        .then(editor => {
                            editor.model.document.on('change:data', () => {
                                const targetTextarea = document.querySelector(textareaId);
                                targetTextarea.value = editor.getData();
                                $(targetTextarea).valid(); // Trigger validasi jQuery langsung sewaktu mengetik
                            });
                        })
                        .catch(error => { console.error("Gagal memuat CKEditor pada " + selector, error); });
                }
            };

            // Inisialisasi Editor untuk kedua panel bahasa
            initCKEditor('#editor_ID', '#editor_ID');
            initCKEditor('#editor_EN', '#editor_EN');

            // Setelan konfigurasi agar jQuery Validator tidak mengabaikan elemen tersembunyi (seperti Textarea bawaan CKEditor & Isian di dalam Tab tidak aktif)
            if ($.validator) {
                $.validator.setDefaults({ ignore: [] });
                
                // Otomatis pindah ke Tab yang bermasalah jika validasi form mendeteksi error saat submit
                $('#formService').on('invalid-form.validate', function(event, validator) {
                    if (validator.numberOfInvalids()) {
                        const firstInvalidElement = $(validator.errorList[0].element);
                        const parentTabPane = firstInvalidElement.closest('.tab-pane');
                        if (parentTabPane.length) {
                            const tabId = parentTabPane.attr('id');
                            const tabTriggerButton = document.querySelector(`button[data-bs-target="#${tabId}"]`);
                            if (tabTriggerButton) {
                                const tabInstance = bootstrap.Tab.getOrCreateInstance(tabTriggerButton);
                                tabInstance.show();
                            }
                        }
                    }
                });
            }

            // --- LOGIKA VALIDASI GAMBAR & PRATINJAU (PREVIEW) ---
            const fileInput = document.getElementById('fileInput');
            const imgPreview = document.getElementById('imgPreview');
            const errorElement = document.getElementById('imageError');
            const submitBtn = document.querySelector('button[type="submit"]');
            const defaultImage = "/uploads/no-image.png";

            fileInput.addEventListener('change', function () {
                const file = this.files[0];
                
                // Reset kondisi awal berkas
                errorElement.innerText = "";
                submitBtn.disabled = false;

                if (file) {
                    const fileSize = file.size / 1024 / 1024; // Konversi ukuran ke satuan MB
                    const fileType = file.type;
                    const maxSize = 5; // Batas maksimal file (5MB)

                    // 1. Validasi Ekstensi Gambar
                    if (!fileType.startsWith('image/')) {
                        errorElement.innerText = "Berkas harus berupa format gambar (JPG, JPEG, PNG).";
                        resetInputFile(this);
                        return;
                    }

                    // 2. Validasi Batasan Ukuran
                    if (fileSize > maxSize) {
                        errorElement.innerText = `Ukuran file (${fileSize.toFixed(2)} MB) terlalu besar! Maksimal ambang batas adalah ${maxSize} MB.`;
                        resetInputFile(this);
                        return;
                    }

                    // 3. Eksekusi Pembacaan URL Gambar untuk Preview
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        imgPreview.src = e.target.result;
                    };
                    reader.readAsDataURL(file);

                } else {
                    imgPreview.src = defaultImage;
                }
            });

            function resetInputFile(inputElement) {
                inputElement.value = ""; 
                imgPreview.src = defaultImage;
                // Form tetap bisa disubmit (gambar sifatnya opsional, namun cegah jika submitBtn ingin dimatikan sepihak)
            }
        });
    </script>
}