@model NewsVM
<div class="card shadow-sm border-0 border-top border-primary border-4 rounded-3">

    <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between border-bottom">
        <div class="d-flex align-items-center">
            <div class="bg-primary-subtle text-primary p-2 rounded-2 me-3 d-flex align-items-center justify-content-center"
                 style="width: 40px; height: 40px;">
                <i class="fa fa-newspaper-o fa-lg" aria-hidden="true"></i>
            </div>
            <div>
                <small class="text-muted">
                    Kelola publikasi konten, unggahan gambar, dan peninjauan teks
                    multi-bahasa
                </small>
            </div>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light border-bottom text-secondary">
                    <tr>
                        <th class="ps-4 py-3" style="width: 110px;">Cover</th>
                        <th class="py-3" style="min-width: 300px;">Informasi & Judul Berita</th>
                        <th class="py-3" style="width: 180px;">Kategori</th>
                        <th class="py-3" style="width: 150px;">Tanggal Rilis</th>
                        <th class="text-center py-3" style="width: 180px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ListBerita != null && Model.ListBerita.Any())
                    {
                        @foreach (var item in Model.ListBerita)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="position-relative shadow-sm rounded overflow-hidden border" style="width: 80px; height: 55px;">
                                        <img src="@(string.IsNullOrEmpty(item.UrlGambar) ? "/images/no-news.png" : item.UrlGambar)"
                                             class="w-100 h-100" style="object-fit: cover;" alt="Cover" />
                                    </div>
                                </td>
                                <td class="py-3">
                                    <div class="fw-bold text-dark">@item.Judul</div>
                                    <small class="text-muted">ID: @item.Judul_ID | EN: @item.Judul_EN</small>
                                </td>
                                <td class="py-3">
                                    <span class="badge bg-secondary-subtle text-secondary border">
                                        @item.Kategori?.NamaKategori
                                    </span>
                                </td>
                                <td class="py-3">@item.CreateAt.ToString("dd MMM yyyy")</td>
                                <td class="text-center">
                                    <div class="btn-group">
                                        <a asp-action="Edit" asp-route-id="@item.IDNews" class="btn btn-warning btn-sm">Edit</a>
                                        <button type="button" onclick="deleteNews(@item.IDNews)" class="btn btn-danger btn-sm">Delete</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <p>Belum ada artikel berita yang diterbitkan.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="d-flex justify-content-center align-items-center mt-3 gap-3" id="pagination-controls">
    <button id="btn-prev" class="btn btn-primary btn-sm @(Model.CurrentPage <= 1 ? "disabled" : "")"
            data-page="@(Model.CurrentPage - 1)">
        <i class="fa fa-arrow-left"></i>
        Previous
    </button>

    <span class="text-muted fw-bold">Page @Model.CurrentPage of @Model.TotalPages</span>

    <button id="btn-next" class="btn btn-warning btn-sm @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
            data-page="@(Model.CurrentPage + 1)">
        Next
        <i class="fa fa-arrow-right"></i>
    </button>
</div>