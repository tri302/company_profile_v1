@model company_profile.PortfolioVM
<div class="row" id="portfolioGrid">
    @if (Model != null && Model.List.Any())
    {
        @foreach (var item in Model.List)
        {
            string? displayTitle = !string.IsNullOrEmpty(item.Judul) ? item.Judul : item.Judul_ID;
            string? displayContent = !string.IsNullOrEmpty(item.IsiContentPortfolio) ? item.IsiContentPortfolio : item.IsiContentPortfolio_ID;

            <div class="col-sm-6 col-md-4 col-xl-3 mb-4 portfolio-item"
                 data-search="@(displayTitle?.ToLower()) @(item.ClientName?.ToLower()) @(item.ClientCompanyName?.ToLower())">
                <div class="card h-100 shadow-sm portfolio-card rounded-3">

                    <div class="img-hover-container" style="height: 190px;">
                        <img src="@(string.IsNullOrEmpty(item.UrlGambar) ? "/uploads/no-image.png" : item.UrlGambar)"
                             class="w-100 h-100 portfolio-img" style="object-fit: cover;"
                             alt="@displayTitle"
                             onerror="this.onerror=null; this.src='/images/no-portfolio.png';">

                        <span class="badge bg-dark bg-opacity-75 position-absolute top-0 start-0 m-2 shadow-sm fw-medium">
                            <i class="fa fa-building me-1 small text-warning"></i> @item.ClientCompanyName
                        </span>

                        @if (item.ListPortfolio != null && item.ListPortfolio.Any())
                        {
                            <span class="badge bg-primary position-absolute top-0 end-0 m-2 shadow-sm fw-medium">
                                <i class="fa fa-images me-1"></i> @item.ListPortfolio.Count Foto
                            </span>
                        }
                    </div>

                    <div class="card-body d-flex flex-column p-3">
                        <h6 class="fw-bold text-dark mb-1 text-truncate" title="@displayTitle">
                            @displayTitle
                        </h6>

                        <span class="text-primary small fw-semibold mb-2 d-block">
                            <i class="fa fa-user me-1 text-muted"></i> @item.ClientName
                        </span>

                        <p class="card-text small text-muted flex-grow-1 text-line-limit mb-3">
                            @{
                                var plainText = System.Text.RegularExpressions.Regex.Replace(displayContent ?? "", "<.*?>", string.Empty);
                                @plainText
                            }
                        </p>

                        <div class="border-top pt-2 mt-auto bg-light mx-n3 px-3 py-2 rounded-bottom-0">
                            <div class="d-flex justify-content-between align-items-center text-muted" style="font-size: 0.75rem;">
                                <span><i class="fa fa-calendar-alt me-1"></i> Durasi:</span>
                                <span class="fw-semibold text-dark">
                                    @item.ProjectStartDate.ToString("MMM yyyy") - @item.ProjectEndDate.ToString("MMM yyyy")
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-white justify-content-center d-flex gap-1">
                        <a asp-action="Edit" asp-route-id="@item.IDPortfolio" class="btn btn-warning btn-sm">
                            <i class="fa fa-edit"></i> Edit
                        </a>
                        <button type="button" onclick="deletePortfolio(@item.IDPortfolio)" class="btn btn-danger btn-sm">
                            <i class="fa fa-trash"></i> Hapus
                        </button>
                    </div>

                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12" id="emptyState">
            <div class="alert alert-light text-center border-dashed py-5 rounded-3 shadow-sm bg-white">
                <div class="text-muted mb-3">
                    <i class="fa fa-folder-open fa-4x" aria-hidden="true"></i>
                </div>
                <h5 class="fw-bold text-dark">Gudang Portfolio Kosong</h5>
                <p class="text-muted small mb-0">Belum ada rekam jejak proyek portfolio yang terdaftar di sistem admin saat ini.</p>
            </div>
        </div>
    }

    <div class="col-12 d-none" id="noResultsState">
        <div class="alert alert-light text-center border-dashed py-5 rounded-3 shadow-sm bg-white">
            <div class="text-muted mb-3">
                <i class="fa fa-search-minus fa-4x" aria-hidden="true"></i>
            </div>
            <h5 class="fw-bold text-dark">Hasil Pencarian Tidak Ditemukan</h5>
            <p class="text-muted small mb-0">Kata kunci tidak cocok dengan judul, nama klien, maupun nama perusahaan manapun.</p>
        </div>
    </div>
</div>

<div class="d-flex justify-content-center align-items-center mt-3 gap-3" id="pagination-controls">
    <button id="btn-prev" class="btn btn-primary btn-sm @(Model.CurrentPage <= 1 ? "disabled" : "")"
            data-page="@(Model.CurrentPage - 1)">
        <i class="fa fa-arrow-left"></i>
        Previous
    </button>

    <span class="text-muted fw-bold">Page @Model.CurrentPage of @Model.TotalPages</span>

    <button id="btn-next" class="btn btn-warning btn-sm @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
            data-page="@(Model.CurrentPage + 1)">
        Next
        <i class="fa fa-arrow-right"></i>
    </button>
</div>