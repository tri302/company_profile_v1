@model IEnumerable<company_profile.ViewModels.HeaderVM>
@{
    ViewData["Title"] = "Company Profile Header";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fa fa-solid fa-industry"> </i> Company Profile Header</h2>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa fa-plus-circle"></i> Create New
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="align-middle ps-3">ID</th>
                            <th class="align-middle">Kontak (Email / Phone)</th>
                            <th class="align-middle">Media Sosial</th>
                            <th class="align-middle text-center">Status Tampil</th>
                            <th class="align-middle text-center" style="width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold">@item.ID</td>
                                    <td>
                                        <div class="mb-1">
                                            <i class="fa fa-envelope text-secondary me-1"></i> @item.EmailAddress
                                        </div>
                                        <div>
                                            <i class="fa fa-phone text-secondary me-1"></i> @item.PhoneNumber
                                        </div>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            @if (!string.IsNullOrEmpty(item.UrlFb))
                                            {
                                                <a href="@item.UrlFb" target="_blank"
                                                   class="badge bg-primary text-decoration-none"><i class="fa fa-facebook"></i>
                                                    FB</a>
                                                }

                                                @if (!string.IsNullOrEmpty(item.UrlTwiter))
                                                {
                                                    <a href="@item.UrlTwiter" target="_blank"
                                                       class="badge bg-info text-dark text-decoration-none"><i
                                                        class="fa fa-twitter"></i> Twitter</a>
                                                    }

                                                    @if (!string.IsNullOrEmpty(item.UrlLinkedIn))
                                                    {
                                                        <a href="@item.UrlLinkedIn" target="_blank"
                                                           class="badge bg-secondary text-decoration-none"><i class="fa fa-linkedin"></i>
                                                            LinkedIn</a>
                                                        }

                                                        @if (!string.IsNullOrEmpty(item.UrlPinterest))
                                                        {
                                                            <a href="@item.UrlPinterest" target="_blank"
                                                               class="badge bg-danger text-decoration-none"><i class="fa fa-pinterest"></i>
                                                                Pinterest</a>
                                                            }

                                                            @if (!string.IsNullOrEmpty(item.UrlYoutube))
                                                            {
                                                                <a href="@item.UrlYoutube" target="_blank"
                                                                   class="badge bg-danger text-decoration-none"><i class="fa fa-youtube"></i>
                                                                    YouTube</a>
                                                                }

                                                                @if (!string.IsNullOrEmpty(item.UrlInstagram))
                                                                {
                                                                    <a href="@item.UrlInstagram" target="_blank"
                                                                       class="badge bg-warning text-dark text-decoration-none"><i
                                                                        class="fa fa-instagram"></i> Instagram</a>
                                                                    }

                                                                    @if (!string.IsNullOrEmpty(item.UrlTiktok))
                                                                    {
                                                                        <a href="@item.UrlTiktok" target="_blank"
                                                                           class="badge bg-dark text-decoration-none"><i class="fa fa-tiktok"></i>
                                                                            TikTok</a>
                                                                        }
                                                                    </div>
                                                                </td>
                                                                <td class="text-center">
                                                                    @if (item.IsShow == true)
                                                                    {
                                                                        <span class="badge bg-success"><i class="fa fa-check-circle"></i> Aktif</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="badge bg-danger"><i class="fa fa-x-circle"></i> Non-Aktif</span>
                                                                    }
                                                                </td>
                                                                <td class="text-center pe-3">
                                                                    <div class="btn-group btn-group-sm" role="group">
                                                                        <a asp-action="Edit" asp-route-id="@item.ID" class="btn btn-warning btn-sm">
                                                                            <i class="fa fa-pencil"></i> Edit
                                                                        </a>
                                                                        <a asp-action="Details" asp-route-id="@item.ID" class="btn btn-sm btn-info btn-sm">
                                                                            <i class="fa fa-eye"></i> Show Details
                                                                        </a>
                                            <button type="button" onclick="deleteData(@item.ID)"
                                                    class="btn btn-danger btn-sm">
                                                <i class="fa fa-trash"></i> Delete
                                            </button>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <tr>
                                                            <td colspan="5" class="text-center text-muted py-4">
                                                                <i class="fa fa-folder-open display-4 d-block mb-2"></i>
                                                                Tidak ada data profile header yang tersedia.
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        function deleteData(id) {
            Swal.fire({
                title: 'Apakah anda yakin?',
                text: "Data yang dihapus tidak dapat dikembalikan!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Ya, hapus!',
                cancelButtonText: 'Batal',
                position: 'top',
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Header/Delete/' + id,
                        type: 'POST',
                        success: function (response) {
                            if (response.success) {
                                Swal.fire(
                                    'Deleted!',
                                    response.message,
                                    'success'
                                ).then(() => {
                                    location.reload(); // Reload halaman untuk melihat perubahan
                                });
                            } else {
                                Swal.fire('Error!', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error!', 'Terjadi kesalahan sistem.', 'error');
                        }
                    });
                }
            })
        }
    </script>

    <script>
        // Menampilkan pesan sukses setelah operasi berhasil
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                Swal.fire({
                icon: 'success',
                title: 'Sukses!',
                text: '@TempData["SuccessMessage"]',
                position: 'top',
                timer: 5000, // Waktu tampil pesan (5 detik)
                showConfirmButton: false
                });
            </text>
        }
    </script>

    <script>
        // Menampilkan pesan error setelah operasi gagal
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                Swal.fire({
                icon: 'error',
                title: 'Error!',
                text: '@TempData["ErrorMessage"]',
                position: 'top',
                timer: 5000, // Waktu tampil pesan (5 detik)
                showConfirmButton: false
                });
            </text>
        }
    </script>
}

                    