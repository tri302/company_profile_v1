@using company_profile.PagenationVM
@model EventsListViewModel
@{
    ViewData["Title"] = "Event Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="fa fa-calendar"></i> Event Management</h2>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa fa-plus-circle"></i> Create New Event
        </a>
    </div>
    <div id="table-container">
        <partial name="_EventsPartial" model="Model" />
    </div>
</div>

@section Scripts {

    <script>
        $(document).ready(function () {
            // Event delegation untuk pagination
            $('#table-container').on('click', 'button.btn:not(.disabled)', function () {
                var targetPage = $(this).data('page');
                $.ajax({
                    url: '@Url.Action("GetPaginatedData", "Events")',
                    data: { pageNumber: targetPage },
                    success: function (result) {
                        $('#table-container').html(result);
                    }
                });
            });
        });
    </script>

<script>
    function deleteEvent(id) {
        Swal.fire({
            title: 'Hapus Event?',
            text: "Data dan file gambar akan dihapus permanen!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Ya, Hapus!',
            cancelButtonText: 'Batal',
            position: 'top',
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '/Events/Delete/' + id, 
                    type: 'POST',
                    success: function (res) {
                        if (res.success) {
                            Swal.fire('Terhapus!', res.message, 'success')
                                .then(() => { location.reload(); });
                        } else {
                            Swal.fire('Gagal!', res.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Error!', 'Terjadi kesalahan sistem.', 'error');
                    }
                });
            }
        });
    }
</script>

<script>
    // Menampilkan pesan sukses setelah operasi berhasil
    @if (TempData["SuccessMessage"] != null)
    {
        <text>
            Swal.fire({
                icon: 'success',
                title: 'Sukses!',
                text: '@TempData["SuccessMessage"]',
                position: 'top',
                timer: 5000, 
                showConfirmButton: false
            });
        </text>
    }        
</script>
}