@model company_profile.EventsVM

@{
    ViewData["Title"] = "Edit Event";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .ck-editor__editable_inline {
        min-height: 250px;
    }
</style>

<div class="container mt-4">
    <div class="card shadow border-0">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="fa fa-edit"></i> Edit Event: @Model.JudulEvent_ID</h5>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" enctype="multipart/form-data" method="post">
                @* Hidden fields wajib untuk proses Update *@
                <input type="hidden" asp-for="IDEvents" />
                <input type="hidden" asp-for="UrlGambar" />

                <div class="row">
                    <div class="col-lg-8 col-md-12 mb-4">
                        <ul class="nav nav-tabs" id="langTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active fw-bold text-primary" id="id-tab" data-bs-toggle="tab" data-bs-target="#langID" type="button" role="tab">
                                    🇮🇩 Bahasa Indonesia
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold text-success" id="en-tab" data-bs-toggle="tab" data-bs-target="#langEN" type="button" role="tab">
                                    🇬🇧 English
                                </button>
                            </li>
                        </ul>
                        
                        <div class="tab-content border border-top-0 p-3 bg-light rounded-bottom" id="langTabsContent">
                            
                            <div class="tab-pane fade show active" id="langID" role="tabpanel">
                                <div class="mb-3">
                                    <label asp-for="JudulEvent_ID" class="form-label fw-bold"></label>
                                    <input asp-for="JudulEvent_ID" class="form-control" />
                                    <span asp-validation-for="JudulEvent_ID" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="AlamatEvent_ID" class="form-label fw-bold"></label>
                                    <input asp-for="AlamatEvent_ID" class="form-control" />
                                    <span asp-validation-for="AlamatEvent_ID" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="LokasiEvent_ID" class="form-label fw-bold"></label>
                                    <input asp-for="LokasiEvent_ID" class="form-control" />
                                    <span asp-validation-for="LokasiEvent_ID" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="IsiContentEvent_ID" class="form-label fw-bold"></label>
                                    <textarea asp-for="IsiContentEvent_ID" id="editor_ID" class="form-control"></textarea>
                                    <span asp-validation-for="IsiContentEvent_ID" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="tab-pane fade" id="langEN" role="tabpanel">
                                <div class="mb-3">
                                    <label asp-for="JudulEvent_EN" class="form-label fw-bold"></label>
                                    <input asp-for="JudulEvent_EN" class="form-control" />
                                    <span asp-validation-for="JudulEvent_EN" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="AlamatEvent_EN" class="form-label fw-bold"></label>
                                    <input asp-for="AlamatEvent_EN" class="form-control" />
                                    <span asp-validation-for="AlamatEvent_EN" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="LokasiEvent_EN" class="form-label fw-bold"></label>
                                    <input asp-for="LokasiEvent_EN" class="form-control" />
                                    <span asp-validation-for="LokasiEvent_EN" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="IsiContentEvent_EN" class="form-label fw-bold"></label>
                                    <textarea asp-for="IsiContentEvent_EN" id="editor_EN" class="form-control"></textarea>
                                    <span asp-validation-for="IsiContentEvent_EN" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="mt-3 p-2 bg-white border rounded">
                                <small class="text-muted d-block mb-1">
                                    <i class="fa fa-info-circle"></i> <strong>Cara mendapatkan URL Peta untuk Lokasi:</strong>
                                </small>
                                <ul class="text-muted small ps-3 mb-0">
                                    <li>Buka <strong>Google Maps</strong> $\rightarrow$ Cari lokasi $\rightarrow$ Klik <strong>Share (Bagikan)</strong>.</li>
                                    <li>Pilih tab <strong>Embed a map</strong> $\rightarrow$ Klik <strong>Copy HTML</strong> dan tempel langsung ke kolom input Lokasi di atas.</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 col-md-12">
                        <div class="p-3 border rounded bg-light mb-3">
                            <label class="form-label fw-bold">Poster Event</label>
                            <div class="preview-container mb-3 border rounded d-flex align-items-center justify-content-center bg-white" style="height: 220px; overflow: hidden;">
                                <img id="imgPreview" 
                                     src="@(string.IsNullOrEmpty(Model.UrlGambar) ? "/uploads/no-image.png" : Model.UrlGambar)" 
                                     class="img-fluid" style="max-height: 100%; object-fit: contain;" alt="Preview" />
                            </div>
                            <input asp-for="UploadGambar" id="fileInput" class="form-control btn-sm" type="file" accept="image/*" />
                            <span id="imageError" class="text-danger small d-block mt-1"></span>
                            <span class="form-text text-muted small">Maksimal 5MB. Format: .jpg, .jpeg, .png. Biarkan kosong jika tidak ingin mengubah gambar.</span>
                            <span asp-validation-for="UploadGambar" class="text-danger"></span>
                        </div>

                        <div class="p-3 border rounded bg-light mb-4">
                            <div class="mb-3">
                                <label asp-for="StartEvent" class="form-label fw-bold"></label>
                                <input asp-for="StartEvent" class="form-control datepicker" type="text" placeholder="dd-mm-yyyy" autocomplete="off" />
                                <span asp-validation-for="StartEvent" class="text-danger"></span>
                            </div>
                            <div class="mb-3">
                                <label asp-for="EndEvent" class="form-label fw-bold"></label>
                                <input asp-for="EndEvent" class="form-control datepicker" type="text" placeholder="dd-mm-yyyy" autocomplete="off" />
                                <span asp-validation-for="EndEvent" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <hr />
                
                <div class="d-flex justify-content-center gap-3">
                    <a asp-action="Index" class="btn btn-secondary btn-sm">
                        <i class="fa fa-arrow-left"></i> Back to List
                    </a>
                    <button type="submit" id="btnSubmit" class="btn btn-success btn-sm">
                        <i class="fa fa-save"></i> Update Event
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        $(document).ready(function () {
            $(".datepicker").datepicker({
                dateFormat: "dd-mm-yy",
                changeMonth: true,
                changeYear: true
            });
        });
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
            // --- LOGIKA CKEDITOR GANDA (ID & EN) ---
            const targetEditors = ['#editor_ID', '#editor_EN'];
            
            targetEditors.forEach(selector => {
                const editorElement = document.querySelector(selector);
                if (editorElement) {
                    ClassicEditor.create(editorElement).then(editor => {
                        editor.model.document.on('change:data', () => {
                            editorElement.value = editor.getData();
                            $(editorElement).valid(); // Trigger validasi jQuery realtime
                        });
                    }).catch(error => { console.error(error); });
                }
            });

            // Izinkan elemen tersembunyi (seperti textarea CKEditor) untuk divalidasi oleh jQuery Validate
            if ($.validator) {
                $.validator.setDefaults({ ignore: [] });
            }

            // --- LOGIKA VALIDASI GAMBAR & PREVIEW ---
            const fileInput = document.getElementById('fileInput');
            const imgPreview = document.getElementById('imgPreview');
            const errorElement = document.getElementById('imageError');
            const submitBtn = document.getElementById('btnSubmit');
            
            // Simpan URL gambar lama/eksisting dari database sebagai backup awal
            const originalImageUrl = imgPreview.src;

            fileInput.addEventListener('change', function () {
                const file = this.files[0];
                errorElement.innerText = "";
                submitBtn.disabled = false;

                if (file) {
                    const fileSize = file.size / 1024 / 1024; // MB
                    const fileType = file.type;
                    const maxSize = 5;

                    if (!fileType.startsWith('image/')) {
                        errorElement.innerText = "File harus berupa gambar (JPG, PNG, dll).";
                        resetToDefault();
                        return;
                    }

                    if (fileSize > maxSize) {
                        errorElement.innerText = `Ukuran file (${fileSize.toFixed(2)} MB) terlalu besar! Maksimal ${maxSize}MB.`;
                        resetToDefault();
                        return;
                    }

                    const reader = new FileReader();
                    reader.onload = function (e) {
                        imgPreview.src = e.target.result;
                    };
                    reader.readAsDataURL(file);
                } else {
                    imgPreview.src = originalImageUrl;
                }
            });

            function resetToDefault() {
                fileInput.value = "";
                imgPreview.src = originalImageUrl; // Balikkan ke gambar eksisting database
                submitBtn.disabled = true;
            }
        });
    </script>
}