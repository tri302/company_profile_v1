@using company_profile.PagenationVM
@model FaqListViewModel
<div class="accordion shadow-sm border rounded overflow-hidden" id="faqAccordion">
    @if (Model.Items != null && Model.Items.Any())
    {
        @* int count = 0; *@
        foreach (var item in Model.Items)
        {
            @* count++; *@
            <div class="accordion-item border-start-0 border-end-0 border-top-0">
                <h2 class="accordion-header" id="heading@item.IDFaq">
                    <button class="accordion-button collapsed py-3" type="button" data-bs-toggle="collapse" data-bs-target="#collapse@item.IDFaq">
                        @* <span class="badge bg-light text-secondary border me-3 fw-bold">#@count</span> *@
                        <div class="d-flex flex-column flex-grow-1 pe-3">
                            <span class="fw-semibold text-dark">@item.JudulFaq_ID</span>
                            <small class="text-muted fst-italic fw-normal mt-1">EN: @item.JudulFaq_EN</small>
                        </div>
                    </button>
                </h2>

                <div id="collapse@item.IDFaq" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body bg-light p-4">
                        <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3 small text-muted">
                            <div>
                                <span class="badge bg-secondary me-2">ID FAQ: @item.IDFaq</span>
                            </div>
                            <div>
                                <i class="fa fa-calendar-alt me-1"></i> Created: @item.CreateAt.ToString("dd MMM yyyy HH:mm")
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="card h-100 border-0 shadow-sm rounded">
                                    <div class="card-header bg-primary bg-opacity-10 text-primary py-2 fw-bold small">
                                        🇮🇩 Bahasa Indonesia
                                    </div>
                                    <div class="card-body bg-white py-3">
                                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">@item.JudulFaq_ID</h6>
                                        <div class="text-secondary small text-break">
                                            @Html.Raw(item.IsiFaq_ID)
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="card h-100 border-0 shadow-sm rounded">
                                    <div class="card-header bg-success bg-opacity-10 text-success py-2 fw-bold small">
                                        🇬🇧 English Version
                                    </div>
                                    <div class="card-body bg-white py-3">
                                        <h6 class="fw-bold text-dark border-bottom pb-2 mb-2">@item.JudulFaq_EN</h6>
                                        <div class="text-secondary small text-break">
                                            @Html.Raw(item.IsiFaq_EN)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                            <a asp-action="Edit" asp-route-id="@item.IDFaq" class="btn btn-sm btn-warning px-3 fw-medium">
                                <i class="fa fa-pencil me-1"></i> Edit
                            </a>
                            <button onclick="deleteFaq(@item.IDFaq)" class="btn btn-sm btn-danger px-3 fw-medium">
                                <i class="fa fa-trash me-1"></i> Delete
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-info border-0 rounded-0 m-0 p-4 text-center">
            <i class="fa fa-info-circle fa-2x mb-2 d-block text-info"></i>
            Belum ada data FAQ yang terdaftar dalam sistem.
        </div>
    }
</div>
<div class="d-flex justify-content-center align-items-center mt-3 gap-3" id="pagination-controls">

    <button id="btn-prev" class="btn btn-primary btn-sm @(Model.CurrentPage <= 1 ? "disabled" : "")"
            data-page="@(Model.CurrentPage - 1)">
        <i class="fa fa-arrow-left"></i>
        Previous
    </button>

    <span class="text-muted fw-bold">Page @Model.CurrentPage of @Model.TotalPages</span>

    <button id="btn-next" class="btn btn-warning btn-sm @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
            data-page="@(Model.CurrentPage + 1)">
        Next
        <i class="fa fa-arrow-right"></i>
    </button>
</div>