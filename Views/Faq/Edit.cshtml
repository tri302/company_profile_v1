@model company_profile.FaqVM
@{
    ViewData["Title"] = "Edit FAQ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .ck-editor__editable_inline {
        min-height: 250px;
    }
</style>

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-9 col-md-11">
            <div class="card shadow border-0">
                <div class="card-header bg-warning text-dark py-3">
                    <h5 class="mb-0 fw-bold"><i class="fa fa-pencil me-2"></i>Edit FAQ</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="IDFaq" />
                        <input type="hidden" asp-for="CreateAt" />

                        <ul class="nav nav-tabs" id="faqEditLangTabs" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button class="nav-link active fw-bold text-primary" id="id-tab" data-bs-toggle="tab" data-bs-target="#langID" type="button" role="tab">
                                    🇮🇩 Bahasa Indonesia
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button class="nav-link fw-bold text-success" id="en-tab" data-bs-toggle="tab" data-bs-target="#langEN" type="button" role="tab">
                                    🇬🇧 English
                                </button>
                            </li>
                        </ul>
                        
                        <div class="tab-content border border-top-0 p-4 bg-light rounded-bottom mb-4" id="faqEditLangTabsContent">
                            
                            <div class="tab-pane fade show active" id="langID" role="tabpanel">
                                <div class="mb-3">
                                    <label asp-for="JudulFaq_ID" class="form-label fw-bold"></label>
                                    <input asp-for="JudulFaq_ID" class="form-control" placeholder="Masukkan pertanyaan dalam Bahasa Indonesia..." />
                                    <span asp-validation-for="JudulFaq_ID" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="IsiFaq_ID" class="form-label fw-bold"></label>
                                    <textarea asp-for="IsiFaq_ID" id="editor_ID" class="form-control"></textarea>
                                    <span asp-validation-for="IsiFaq_ID" class="text-danger"></span>                                    
                                </div>
                            </div>

                            <div class="tab-pane fade" id="langEN" role="tabpanel">
                                <div class="mb-3">
                                    <label asp-for="JudulFaq_EN" class="form-label fw-bold"></label>
                                    <input asp-for="JudulFaq_EN" class="form-control" placeholder="Enter question in English..." />
                                    <span asp-validation-for="JudulFaq_EN" class="text-danger"></span>
                                </div>
                                <div class="mb-3">
                                    <label asp-for="IsiFaq_EN" class="form-label fw-bold"></label>
                                    <textarea asp-for="IsiFaq_EN" id="editor_EN" class="form-control"></textarea>
                                    <span asp-validation-for="IsiFaq_EN" class="text-danger"></span>                                    
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center border-top pt-3">
                            <a asp-action="Index" class="btn btn-secondary btn-sm px-3">
                                <i class="fa fa-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-success btn-sm px-4 shadow-sm fw-medium">
                                <i class="fa fa-save me-1"></i> Update FAQ
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            
            // --- INISIALISASI CKEDITOR GANDA (ID & EN) ---
            const targetEditors = ['#editor_ID', '#editor_EN'];
            
            targetEditors.forEach(selector => {
                const editorElement = document.querySelector(selector);
                if (editorElement) {
                    ClassicEditor
                        .create(editorElement)
                        .then(editor => {
                            // Sinkronisasi data realtime dari CKEditor ke Textarea asli ASP.NET saat user mengetik
                            editor.model.document.on('change:data', () => {
                                editorElement.value = editor.getData();
                                
                                // Trigger validasi jQuery Validate secara langsung agar error message hilang setelah diisi
                                if ($.validator) {
                                    $(editorElement).valid();
                                }
                            });
                        })
                        .catch(error => { console.error(error); });
                }
            });

            // Ubah konfigurasi default agar jQuery Validate tidak mengabaikan elemen tersembunyi (hidden textarea dari CKEditor)
            if ($.validator) {
                $.validator.setDefaults({ ignore: [] });
            }
        });
    </script>
}