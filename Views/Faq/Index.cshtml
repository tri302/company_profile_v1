@using company_profile.PagenationVM
@model FaqListViewModel
@{
    ViewData["Title"] = "FAQ Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h4 mb-0 fw-bold text-secondary">
            <i class="fa fa-question-circle text-primary me-2"></i>FAQ Management
        </h2>
        <a asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm">
            <i class="fa fa-plus-circle me-1"></i> Add New FAQ
        </a>
    </div>
    <div id="table-container">
        <partial name="_FaqPartial.cshtml" model="Model" />
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Event delegation untuk pagination
            $('#table-container').on('click', 'button.btn:not(.disabled)', function () {
                var targetPage = $(this).data('page');
                $.ajax({
                    url: '@Url.Action("GetPaginatedData", "Faq")',
                    data: { pageNumber: targetPage },
                    success: function (result) {
                        $('#table-container').html(result);
                    }
                });
            });
        });
    </script>
    <script>
        function deleteFaq(id) {
            Swal.fire({
                title: 'Hapus FAQ?',
                text: "Data ini akan dihapus secara permanen dari sistem!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Ya, Hapus',
                cancelButtonText: 'Batal',
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                position: 'top',
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Faq/Delete/' + id,
                        type: 'POST',
                        success: function (res) {
                            if (res.success) {
                                location.reload();
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Gagal!',
                                    text: 'Gagal menghapus data FAQ.',
                                    position: 'top'
                                });
                            }
                        }
                    });
                }
            });
        }
    </script>

    <script>
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Sukses!',
                    text: '@TempData["SuccessMessage"]',
                    position: 'top',
                    timer: 4000,
                    showConfirmButton: false
                });
            </text>
        }        
    </script>
}