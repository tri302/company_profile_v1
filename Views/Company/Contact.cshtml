@using company_profile;
@model ContactVM;
@{
    ViewData["Title"] = "Contact page";
    Layout = "_FrontEndLayout";
}
<!--Banner Start-->
@await Component.InvokeAsync("Banner", new { pageName = "Contact Page" })
<!--Banner End-->

<!--Contact Start-->
<div class="contact-area pt-2 pb-2">
    <div class="container">
        <div class="row">
            @if (Model.ListContact != null && Model.ListContact.Any())
            {
                @* 1. BOX ADDRESS *@
                <div class="col-xl-4 col-md-6">
                    <div class="contact-item d-flex">
                        <div class="contact-icon">
                            <i class="fa fa-map-marker" aria-hidden="true"></i>
                        </div>
                        <div class="contact-text">
                            <h4>Address</h4>
                            @foreach (var item in Model.ListContact.Where(x => !string.IsNullOrEmpty(x.Alamat)))
                            {
                                <p style="margin-bottom: 5px;">@Html.Raw(item.Alamat)</p>
                            }
                        </div>
                    </div>
                </div>

                @* 2. BOX PHONE *@
                <div class="col-xl-4 col-md-6">
                    <div class="contact-item d-flex">
                        <div class="contact-icon">
                            <i class="fa fa-mobile" aria-hidden="true"></i>
                        </div>
                        <div class="contact-text">
                            <h4>Phone Number</h4>
                            @foreach (var item in Model.ListContact.Where(x => !string.IsNullOrEmpty(x.PhoneNumber)))
                            {
                                <p style="margin-bottom: 2px;">@Html.Raw(item.PhoneNumber)</p>
                            }
                        </div>
                    </div>
                </div>

                @* 3. BOX EMAIL *@
                <div class="col-xl-4 col-md-6">
                    <div class="contact-item d-flex">
                        <div class="contact-icon">
                            <i class="fa fa-envelope-o" aria-hidden="true"></i>
                        </div>
                        <div class="contact-text">
                            <h4>Email Address</h4>
                            @foreach (var item in Model.ListContact.Where(x => !string.IsNullOrEmpty(x.EmailAddress)))
                            {
                                <p style="margin-bottom: 2px;">@Html.Raw(item.EmailAddress)</p>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
        
        <!--Form Contact Start-->
        <div class="contact-form headstyle pt-2">
            <h4>Contact Form</h4>
            <!-- Beri id="contactForm" pada tag form -->
            <form id="contactForm" action="/UserContacted/Create" method="post" accept-charset="utf-8">
                @Html.AntiForgeryToken() <!-- Pastikan Token ini ada jika tidak pakai tag helper form asli ASP.NET -->
    
                <div class="form-row row">
                    <div class="form-group col-md-6">
                        <input asp-for="ContactForm.Name" type="text" class="form-control" placeholder="Name" />
                        <span id="error_ContactForm_Name" class="text-danger-ajax text-danger"></span>
                    </div>
                    <div class="form-group col-md-6">
                        <input asp-for="ContactForm.PhoneNumber" type="text" class="form-control"
                               placeholder="Phone Number" />
                        <span id="error_ContactForm_PhoneNumber" class="text-danger-ajax text-danger"></span>
                    </div>
                    <div class="form-group col-md-6">
                        <input asp-for="ContactForm.EmailAddress" type="email" class="form-control"
                               placeholder="Email Address" />
                        <span id="error_ContactForm_EmailAddress" class="text-danger-ajax text-danger"></span>
                    </div>
                    <div class="form-group col-md-6">
                        <input asp-for="ContactForm.Subject" type="text" class="form-control"
                               placeholder="Subject Email" />
                        <span id="error_ContactForm_Subject" class="text-danger-ajax text-danger"></span>
                    </div>
                    <div class="form-group col-12">
                        <textarea asp-for="ContactForm.Pesan" class="form-control" placeholder="Pesan Email"></textarea>
                        <span id="error_ContactForm_Pesan" class="text-danger-ajax text-danger"></span>
                    </div>

                    <div class="form-group col-12">
                        <div class="captcha-section-1">
                            <label><strong id="questionText">@ViewBag.CaptchaQuestion</strong></label>
                        </div>
                        <div class="captcha-section-2">
                            <input type="number" name="userCaptcha" id="userCaptchaInput" class="form-control" required
                                   autocomplete="off" />                            
                        </div>
                        <span id="error_userCaptcha" class="text-danger-ajax text-danger ml-2"></span>
                    </div>
        
                    <div class="form-group col-12">
                        <button type="submit" class="btn" name="form_contact">Send Message</button>
                    </div>
                </div>
            </form>
        </div>        
    </div>
</div>
<!--Contact End-->

<!--Call Start-->
@await Component.InvokeAsync("Cta")
<!--Call End-->

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/sweetalert2@11.js"></script>

    <script>
        $(document).ready(function () {
            // Pastikan ID selector di bawah ini (#contactForm) SAMA dengan id di tag <form id="contactForm"> Anda
            $("#contactForm").on("submit", function (e) {
                e.preventDefault(); // Menghentikan reload halaman bawaan browser

                // Bersihkan pesan error lama sebelum request baru dikirim
                $(".text-danger-ajax").text("");
                $("#captchaError").text("");
                @* $("#successMessage").addClass("d-none").text(""); *@

                var form = $(this);
                
                // Ambil URL dari atribut action form, atau set langsung manual jika action-nya masih '#'
                var actionUrl = form.attr("action");
                if (actionUrl === "#" || actionUrl === "") {
                    actionUrl = "/Company/Contact"; // Sesuaikan dengan Route / Controller terget Anda
                }
                
                var formData = form.serialize();

                $.ajax({
                    url: actionUrl,
                    type: "POST",
                    data: formData,
                    success: function (response) {
                        // 1. Selalu perbarui pertanyaan captcha secara realtime jika ada kiriman soal baru dari server
                        if (response.newCaptchaQuestion) {
                            $("#questionText").text(response.newCaptchaQuestion);
                        }

                        // 2. Jika Server merespon sukses (Data tersimpan & Captcha benar)
                        if (response.success) {                            
                            Swal.fire({
                                icon: 'success',
                                title: 'Sukses!',
                                text: response.message,
                                position: 'top',
                                timer: 5000, // Waktu tampil pesan (5 detik)
                                showConfirmButton: false
                            });
                            form[0].reset(); // Kosongkan isi semua input form
                        }
                        // 3. Jika Server merespon gagal (Captcha salah atau validasi model state gagal)
                        else {
                            if (response.errors) {
                                $.each(response.errors, function (key, value) {
                                    // Antisipasi nama properti complex (cth: ContactForm.Name menjadi ContactForm_Name)
                                    var cleanKey = key.replace(/\./g, '_');                                    
                                    // Cari span error berdasarkan ID bawaan atau ID kustom Anda
                                    var elementId = "#error_" + cleanKey;                                    
                                    // Jika tidak ketemu, coba cari span yang menggunakan asp-validation-for bawaan ASP.NET
                                    if ($(elementId).length === 0) {
                                        // Mencari span berdasarkan atribut name properti yang error
                                        $("[asp-validation-for='ContactForm." + key + "']").text(value);
                                        $("[asp-validation-for='" + key + "']").text(value);
                                    } else {
                                        $(elementId).text(value);
                                    }
                                });
                            }
                            
                            // Kosongkan field input captcha yang salah agar user bisa isi ulang
                            $("#userCaptchaInput").val("");
                        }
                    },
                    error: function (xhr, status, error) {
                        alert("Terjadi kesalahan sistem pada AJAX request.");
                        console.error(xhr.responseText);
                    }
                });
            });
        });
    </script>
}

    