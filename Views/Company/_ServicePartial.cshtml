@using company_profile;
@model OurServicesVM;
<!--Services Start-->
<div class="services-area pt_90 pb_90">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="headline">
                    <h2>OUR SERVICES</h2>
                    <h3>We are always here to serve you some awesome services</h3>
                </div>
            </div>
        </div>
        <div class="row">
            @if (!Model.ListOurServices.Any())
            {
                <div class="col-12">
                    <p class="text-center">No services available at the moment.</p>
                </div>
            }
            else
            {
                @foreach (var item in Model.ListOurServices)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="services-item effect-item">
                            <a href="#" class="image-effect">
                                <div class="services-photo" style="background-image: url('@Url.Content(item.UrlGambar)');">
                                </div>
                            </a>
                            <div class="services-text">
                                <h3>@item.JudulService</h3>
                                <p>
                                    @* Batasi 100 karakter untuk deskripsi singkat *@
                                    @Html.Raw(@item.IsiService.Length > 100 ? @item.IsiService.Substring(0, 100) + "..." : @item.IsiService)                                
                                </p>
                                <div class="button-bn">
                                    <a asp-action="ServiceDetail" asp-route-id="@item.IDOurServices">Read More
                                        <i class="fa fa-chevron-circle-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                }
            }
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-center align-items-center mt-4" id="pagination-controls">
                <button id="btn-prev" class="btn btn-primary btn-sm @(Model.CurrentPage <= 1 ? "disabled" : "")"
                        data-page="@(Model.CurrentPage - 1)">
                    <i class="fa fa-arrow-left"></i> Previous
                </button>

                <span class="text-muted fw-bold mx-4">Page @Model.CurrentPage of @Model.TotalPages</span>

                <button id="btn-next" class="btn btn-warning btn-sm @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                        data-page="@(Model.CurrentPage + 1)">
                    Next <i class="fa fa-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>
<!--Services End-->