<!--Booking-Area Start-->
<div class="booking-area pt_60 pb_90" style="background-image: url('@Url.Content("~/uploads/contactformimg.png")')">
    <div class="bg-booking"></div>
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="booking-gallery">
                    <div class="headline hl-white hl-left">
                        <h2>@Localizer["BookingForm"]</h2>
                    </div>
                    <div class="booking-form pt_30">
                        <!-- Tambahkan ID pada form -->
                        <form id="contactForm" action="/UserContacted/Create" method="post" accept-charset="utf-8">
                            @Html.AntiForgeryToken()
                            <!-- Pastikan Token ini ada jika tidak pakai tag helper form asli ASP.NET -->

                            <div class="form-row row">
                                <div class="form-group col-md-6">
                                    <input asp-for="ContactForm.Name" type="text" class="form-control"
                                           placeholder="Name" />
                                    <span id="error_ContactForm_Name" class="text-danger-ajax text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <input asp-for="ContactForm.PhoneNumber" type="text" class="form-control"
                                           placeholder="Phone Number" />
                                    <span id="error_ContactForm_PhoneNumber"
                                          class="text-danger-ajax text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <input asp-for="ContactForm.EmailAddress" type="email" class="form-control"
                                           placeholder="Email Address" />
                                    <span id="error_ContactForm_EmailAddress"
                                          class="text-danger-ajax text-danger"></span>
                                </div>
                                <div class="form-group col-md-6">
                                    <input asp-for="ContactForm.Subject" type="text" class="form-control"
                                           placeholder="Subject Email" />
                                    <span id="error_ContactForm_Subject" class="text-danger-ajax text-danger"></span>
                                </div>
                                <div class="form-group col-12">
                                    <textarea asp-for="ContactForm.Pesan" class="form-control"
                                              placeholder="Pesan Email"></textarea>
                                    <span id="error_ContactForm_Pesan" class="text-danger-ajax text-danger"></span>
                                </div>

                                <div class="form-group col-12">
                                    <div class="captcha-section-1">
                                        <label><strong id="questionText">@ViewBag.CaptchaQuestion</strong></label>
                                    </div>
                                    <div class="captcha-section-2">
                                        <input type="number" name="userCaptcha" id="userCaptchaInput"
                                               class="form-control" required autocomplete="off" />
                                    </div>
                                    <b>
                                        <span id="error_userCaptcha" class="text-danger-ajax text-danger ml-2"></span>
                                    </b>
                                </div>
                                <div class="form-button">
                                    <button type="submit" class="btn" name="form_portfolio">Submit</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- FAQ Area tetap sama seperti kode Anda -->
            <div class="col-lg-6">
                <!-- ... bagian FAQ ... -->
                <div class="container">
                    <div class="headline hl-white hl-left">
                        <h2>@Localizer["Tanya"]</h2>
                    </div>
                    <div class="row">
                        <div class="col-12">
                            <div class="faq-group headstyle mt-30">
                                <div id="accordion">
                                    @if (Model?.Faq == null || !Model.Faq.Any())
                                    {
                                        <div class="faq-item card">
                                            <div class="faq-body">
                                                <p>Belum ada pertanyaan yang tersedia.</p>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        var index = 0;
                                        foreach (var item in Model.Faq)
                                        {
                                            var headingId = $"heading{index}";
                                            var collapseId = $"collapse{index}";
                                            var isFirst = index == 0;

                                            <div class="faq-item card">
                                                <div class="faq-header" id="@headingId">
                                                    <button class="faq-button @(isFirst ? "" : "collapsed")"
                                                            data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                                            aria-expanded="@(isFirst.ToString().ToLower())"
                                                            aria-controls="@collapseId">
                                                        <i class="fa fa-caret-right"></i>
                                                        @item.JudulFaq
                                                    </button>
                                                </div>

                                                <div id="@collapseId" class="collapse @(isFirst ? "show" : "")"
                                                     aria-labelledby="@headingId" data-parent="#accordion">
                                                    <div class="faq-body">
                                                        <p>@Html.Raw(item.IsiFaq)</p>
                                                    </div>
                                                </div>
                                            </div>

                                            index++;
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!--Booking-Area End-->

<!--Call Start-->
@await Component.InvokeAsync("Cta")
<!--Call End-->
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            // Pastikan ID selector di bawah ini (#contactForm) SAMA dengan id di tag <form id="contactForm"> Anda
            $("#contactForm").on("submit", function (e) {
                e.preventDefault(); // Menghentikan reload halaman bawaan browser
                // Bersihkan pesan error lama sebelum request baru dikirim
                $(".text-danger-ajax").text("");
                var form = $(this);
                // Ambil URL dari atribut action form, atau set langsung manual jika action-nya masih '#'
                var actionUrl = form.attr("action");
                if (actionUrl === "#" || actionUrl === "") {
                    actionUrl = "/Company/Home"; // Sesuaikan dengan Route / Controller terget Anda
                }
                var formData = form.serialize();
                $.ajax({
                    url: actionUrl,
                    type: "POST",
                    data: formData,
                    success: function (response) {
                        // 1. Selalu perbarui pertanyaan captcha secara realtime jika ada kiriman soal baru dari server
                        if (response.newCaptchaQuestion) {
                            $("#questionText").text(response.newCaptchaQuestion);
                        }
                        // 2. Jika Server merespon sukses (Data tersimpan & Captcha benar)
                        if (response.success) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Sukses!',
                                text: response.message,
                                position: 'top',
                                timer: 5000, // Waktu tampil pesan (5 detik)
                                showConfirmButton: false
                            });
                            form[0].reset(); // Kosongkan isi semua input form
                        }
                        // 3. Jika Server merespon gagal (Captcha salah atau validasi model state gagal)
                        else {
                            if (response.errors) {
                                $.each(response.errors, function (key, value) {
                                    // Antisipasi nama properti complex (cth: ContactForm.Name menjadi ContactForm_Name)
                                    var cleanKey = key.replace(/\./g, '_');
                                    // Cari span error berdasarkan ID bawaan atau ID kustom Anda
                                    var elementId = "#error_" + cleanKey;
                                    // Jika tidak ketemu, coba cari span yang menggunakan asp-validation-for bawaan ASP.NET
                                    if ($(elementId).length === 0) {
                                        // Mencari span berdasarkan atribut name properti yang error
                                        $("[asp-validation-for='ContactForm." + key + "']").text(value);
                                        $("[asp-validation-for='" + key + "']").text(value);
                                    } else {
                                        $(elementId).text(value);
                                    }
                                });
                            }
                            // Kosongkan field input captcha yang salah agar user bisa isi ulang
                            $("#userCaptchaInput").val("");
                        }
                    },
                    error: function (xhr, status, error) {
                        swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Terjadi kesalahan saat mengirim data. Silakan coba lagi.',
                            position: 'top',
                            timer: 5000,
                            showConfirmButton: false
                        });
                        console.error(xhr.responseText);
                    }
                });
            });
        });
    </script>

    <script>
        $(document).ready(function () {
            // Hancurkan instansiasi lama jika sempat macet
            var $slider = $('.slide-carousel');
            if ($slider.hasClass('owl-loaded')) {
                $slider.owlCarousel('destroy');
            }

            // Inisialisasi ulang secara paksa setelah DOM siap
            $slider.owlCarousel({
                loop: true,
                autoplay: true,
                autoplayTimeout: 5000,
                animateOut: 'fadeOut',
                animateIn: 'fadeIn',
                items: 1,
                nav: true,
                dots: true,
                navText: ['<i class="fa fa-angle-left"></i>', '<i class="fa fa-angle-right"></i>']
            });
        });
    </script>
    <script>
                $(".btn-play-video").click(function () {
                let rawData = $(this).data("url"); // Ini berisi string iframe lengkap
                let videoUrl = "";

                // Cek apakah data berisi tag iframe atau hanya URL biasa
                if (rawData.includes("<iframe")) {
                                                 // Ekstrak URL dari atribut src di dalam string iframe
                                                 let match=rawData.match(/src ="([^" ]+)" /);
                                             videoUrl=match ? match[1] : rawData;
                                             } else {
                                             videoUrl=rawData;
                                             }
                                             // Set source iframe modal
                                             $("#videoIframe").attr("src", videoUrl);
        });
    </script>
}
