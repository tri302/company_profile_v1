@using company_profile;
@model PricingVM
<!--Banner Start-->
<!--Price-Table Start-->
<div class="price-area price-page pt_60 pb_90">
    <div class="container">
        <div class="row">
            @if (!Model.List.Any())
            {
                <p>No pricing options available.</p>
            }
            else
            {
                @foreach (var item in Model.List)
                {
                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="price-item">
                            <div class="price-header">
                                <i class="fa fa-shield" aria-hidden="true"></i>
                                <h3>@item.JenisLayanan</h3>
                                <h2>@string.Format(new System.Globalization.CultureInfo("id-ID"), "Rp {0:N0}", item.Harga)</h2>
                            </div>
                            <div class="price-body">
                                @Html.Raw(item.DeskripsiJenisLayanan)
                            </div>
                            <div class="price-footer">
                                <div class="button-df">
                                    <a href="#">Choose Us <i class="fa fa-chevron-circle-right"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="d-flex justify-content-center align-items-center mt-4" id="pagination-controls">
                    <button id="btn-prev" class="btn btn-primary btn-sm @(Model.CurrentPage <= 1 ? "disabled" : "")"
                            data-page="@(Model.CurrentPage - 1)">
                        <i class="fa fa-arrow-left"></i> Previous
                    </button>

                    <!-- Menambahkan mx-4 untuk memberi jarak kiri dan kanan pada teks -->
                    <span class="text-muted fw-bold mx-4">Page @Model.CurrentPage of @Model.TotalPages</span>

                    <button id="btn-next" class="btn btn-warning btn-sm @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                            data-page="@(Model.CurrentPage + 1)">
                        Next <i class="fa fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
    <!--Price-Table End-->