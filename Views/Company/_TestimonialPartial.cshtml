@using company_profile
@model TestimonialVM
<!--Testimonial Start-->
<div class="testimonial-area testimonial-grid pt_60 pb_90">
    <div class="container">
        <div class="row">
            @if (!Model.List.Any())
            {
                <div class="col-12">
                    <p>No testimonials available.</p>
                </div>
            }
            else
            {
                @foreach (var item in Model.List)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="testimonial-item mt_30">
                            <div class="testimonial-photo">
                                <img src="@Url.Content(item.UrlGambar)" alt="Testimonial Photo" />
                            </div>
                            <div class="testimonial-name">
                                <h4>@item.Nama</h4>
                                <p>@item.Jabatan</p>
                            </div>
                            <div class="testimonial-description">                                
                                @Html.Raw(item.IsiTestimoni)
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="d-flex justify-content-center align-items-center mt-4" id="pagination-controls">
                <button id="btn-prev" class="btn btn-primary btn-sm @(Model.CurrentPage <= 1 ? "disabled" : "")"
                        data-page="@(Model.CurrentPage - 1)">
                    <i class="fa fa-arrow-left"></i> Previous
                </button>

                <!-- Menambahkan mx-4 untuk memberi jarak kiri dan kanan pada teks -->
                <span class="text-muted fw-bold mx-4">Page @Model.CurrentPage of @Model.TotalPages</span>

                <button id="btn-next" class="btn btn-warning btn-sm @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                        data-page="@(Model.CurrentPage + 1)">
                    Next <i class="fa fa-arrow-right"></i>
                </button>
            </div>
        </div>
    </div>
</div>
<!--Testimonial End-->