@using company_profile;
@model PhotoGalleryVM;
@if (Model.ListOurPhotoGallery == null || !Model.ListOurPhotoGallery.Any())
{
    <div class="gallery-page pt_60 pb_90">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 col-sm-12">
                    <div class="gallery-group">
                        <h3 class="text-center">No photo gallery data</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="gallery-page pt_60 pb_90">
        <div class="container">
            <div class="row">

                @foreach (var item in Model.ListOurPhotoGallery)
                {
                    <div class="col-lg-4 col-sm-6">
                        <div class="gallery-group">
                            <div class="gallery-photo" style="background-image:url('@Url.Content(item.UrlGambar)');">
                                <div class="gallery-bg"></div>
                                <div class="gallery-table">
                                    <div class="gallery-icon">
                                        <a href="@Url.Content(item.UrlGambar)" class="magnific">
                                            <i class="fa fa-search-plus"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="d-flex justify-content-center align-items-center mt-4" id="pagination-controls">
                    <button id="btn-prev" class="btn btn-primary btn-sm @(Model.CurrentPage <= 1 ? "disabled" : "")"
                            data-page="@(Model.CurrentPage - 1)">
                        <i class="fa fa-arrow-left"></i> Previous
                    </button>

                    <!-- Menambahkan mx-4 untuk memberi jarak kiri dan kanan pada teks -->
                    <span class="text-muted fw-bold mx-4">Page @Model.CurrentPage of @Model.TotalPages</span>

                    <button id="btn-next" class="btn btn-warning btn-sm @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
                            data-page="@(Model.CurrentPage + 1)">
                        Next <i class="fa fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
}

