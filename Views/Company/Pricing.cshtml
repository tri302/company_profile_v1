@using company_profile;
@model PricingVM
@{
    ViewData["Title"] = "Pricing page";
    Layout = "_FrontEndLayout";
}
<!--Banner Start-->
@await Component.InvokeAsync("Banner", new { pageName = "Pricing Page" })
<!--Banner End-->
<div id="table-container">
    <partial name="_PricingPartial" model="Model" />
</div>
<!--Call Start-->
@await Component.InvokeAsync("Cta")
<!--Call End-->
@section Scripts {
    @if (ViewBag.Message != null)
    {
        <div class="container" style="margin-top:20px;">
            <div class="alert alert-info">@ViewBag.Message</div>
        </div>
    }
    <script>
        $(document).ready(function () {
            // Event delegation untuk pagination
            $('#table-container').on('click', 'button.btn:not(.disabled)', function () {
                var targetPage = $(this).data('page');
                $.ajax({
                    url: '@Url.Action("GetPaginatedDataPricing", "Company")',
                    data: { pageNumber: targetPage },
                    success: function (result) {
                        $('#table-container').html(result);
                    },
                    error: function (xhr, status, error) {
                        console.error("Gagal memuat halaman: ", error);
                    }
                });
            });
        });
    </script>
}