@model WhyChooseUsListViewModel
@using System.Text.RegularExpressions
@using company_profile.PagenationVM

<div class="container-fluid px-4 py-4">    
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            @* <th class="ps-4">ID</th> *@
                            <th>Judul</th>
                            <th>Isi Konten</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    @* <td class="ps-4 text-muted">#@item.Id</td> *@
                                    <td class="fw-semibold text-dark text-judul"
                                        data-id="@item.JudulWhyChooseUs_ID"
                                        data-en="@item.JudulWhyChooseUs_EN">
                                        @item.JudulWhyChooseUs
                                    </td>
                                    <td>
                                        <div class="text-truncate text-konten" style="max-width: 400px;"
                                             data-id=" @Html.Raw(@item.IsiContentWhyChooseUs_ID)"
                                             data-en=" @Html.Raw(@item.IsiContentWhyChooseUs_EN)">
                                            @Html.Raw(@item.IsiContentWhyChooseUs)                                            
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm"><i class="fa fa-edit"></i> Edit </a>
                                        <button onclick="deleteData(@item.Id)" class="btn btn-danger btn-sm">
                                            <i class="fa fa-trash"></i>
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-center align-items-center mt-3 gap-3" id="pagination-controls">

    <button id="btn-prev" class="btn btn-primary btn-sm @(Model.CurrentPage <= 1 ? "disabled" : "")"
            data-page="@(Model.CurrentPage - 1)">
            <i class="fa fa-arrow-left"></i>
        Previous
    </button>

    <span class="text-muted fw-bold">Page @Model.CurrentPage of @Model.TotalPages</span>

    <button id="btn-next" class="btn btn-warning btn-sm @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
            data-page="@(Model.CurrentPage + 1)">
        Next
        <i class="fa fa-arrow-right"></i>
    </button>
</div>