@using company_profile.PagenationVM
@model WhyChooseUsListViewModel
@{
    ViewData["Title"] = "Kelola Why Choose Us";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 text-gray-800">Kelola "Why Choose Us"</h1>
    </div>
    <div>
        <select id="langSwitcher" class="form-select form-select-sm d-inline-block w-auto me-2">
            <option value="ID">🇮🇩 ID</option>
            <option value="EN">🇺🇸 EN</option>
        </select>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa fa-plus-circle"></i> Create New
        </a>
    </div>    
</div>
<div id="table-container">
    <partial name="_WhyChooseUsTablePartial" model="Model" />
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Event delegation untuk pagination
            $('#table-container').on('click', 'button.btn:not(.disabled)', function () {
                var targetPage = $(this).data('page');
                $.ajax({
                    url: '@Url.Action("GetPaginatedData", "WhyChooseUs")',
                    data: { pageNumber: targetPage },
                    success: function (result) {
                        $('#table-container').html(result);
                    }
                });
            });
        });

        // Logika Bahasa
        document.getElementById('langSwitcher').addEventListener('change', function() {
            const lang = this.value;
            document.querySelectorAll('.text-judul').forEach(el => {
                el.innerHTML = (lang === 'ID') ? el.getAttribute('data-id') : el.getAttribute('data-en');
            });
            document.querySelectorAll('.text-konten').forEach(el => {
                el.innerHTML = (lang === 'ID') ? el.getAttribute('data-id') : el.getAttribute('data-en');
            });
        });

        //Fungsi delete
        function deleteData(id) {
            Swal.fire({ title: 'Hapus data?', icon: 'warning', showCancelButton: true })
            .then((result) => {
                if (result.isConfirmed) {
                    $.post('/WhyChooseUs/Delete/' + id, function(res) {
                        if (res.success) location.reload();
                    });
                }
            });
        }
    </script>

    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            Swal.fire({ icon: 'success', title: 'Berhasil!', text: '@Html.Raw(TempData["SuccessMessage"])' });
        </script>
    }
}