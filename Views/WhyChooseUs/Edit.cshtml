@model company_profile.ViewModels.WhyChooseUsVM

@{
    ViewData["Title"] = "Ubah Why Choose Us";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<style>
    .ck-editor__editable_inline {
        min-height: 250px;
    }
</style>
<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Ubah Data "Why Choose Us"</h1>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="UrlGambar" />

                <ul class="nav nav-tabs mb-4" id="langTabs" role="tablist">
                    <li class="nav-item"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#id-pane" type="button">🇮🇩 Bahasa Indonesia</button></li>
                    <li class="nav-item"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#en-pane" type="button">🇺🇸 English</button></li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="id-pane">
                        <div class="mb-3">
                            <label asp-for="JudulWhyChooseUs_ID" class="form-label fw-semibold">Judul (ID)</label>
                            <input asp-for="JudulWhyChooseUs_ID" class="form-control" />
                            <span asp-validation-for="JudulWhyChooseUs_ID" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="IsiContentWhyChooseUs_ID" class="form-label fw-semibold">Isi Konten (ID)</label>
                            <textarea asp-for="IsiContentWhyChooseUs_ID" id="editor_ID" class="form-control" rows="4"></textarea>
                           <span asp-validation-for="IsiContentWhyChooseUs_ID" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="tab-pane fade" id="en-pane">
                        <div class="mb-3">
                            <label asp-for="JudulWhyChooseUs_EN" class="form-label fw-semibold">Title (EN)</label>
                            <input asp-for="JudulWhyChooseUs_EN" class="form-control" />
                            <span asp-validation-for="JudulWhyChooseUs_EN" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="IsiContentWhyChooseUs_EN" class="form-label fw-semibold">Content (EN)</label>                 <textarea asp-for="IsiContentWhyChooseUs_EN" id="editor_EN" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="IsiContentWhyChooseUs_EN" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-md-3 text-center">
                        <label class="form-label d-block fw-semibold">Gambar Saat Ini</label>
                        <img src="@Model.UrlGambar" class="img-thumbnail" style="max-height: 100px;" />
                    </div>
                    <div class="col-md-9">
                        <label asp-for="UploadGambar" class="form-label fw-semibold">Ganti Gambar (Opsional)</label>
                        <input asp-for="UploadGambar" type="file" class="form-control" accept="image/*" />
                        <span asp-validation-for="UploadGambar" class="text-danger"></span>
                    </div>
                </div>

                <hr class="my-4">

                <div align="center">
                    <a asp-action="Index" class="btn btn-secondary btn-sm me-1"><i class="fa fa-arrow-left"></i> Cancel</a>
                    <button type="submit" class="btn btn-success btn-sm"><i class="fa fa-save"></i> Simpan Perubahan</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Gunakan querySelectorAll untuk mengambil semua elemen yang cocok
            const editors = document.querySelectorAll('#editor_ID, #editor_EN');

            editors.forEach(editorElement => {
                ClassicEditor
                    .create(editorElement)
                    .then(editor => {
                        // Update textarea/input asli saat konten berubah
                        editor.model.document.on('change:data', () => {
                            editorElement.value = editor.getData();

                            // Trigger validasi jQuery jika tersedia
                            if (typeof $ !== 'undefined' && $(editorElement).valid) {
                                $(editorElement).valid();
                            }
                        });
                    })
                    .catch(error => { console.error(error); });
            });
        });
        // Konfigurasi Validasi jQuery agar tidak mengabaikan elemen hidden (textarea bawaan CKEditor)
        if ($.validator) {
        $.validator.setDefaults({ ignore: [] });
        }
    </script>
}