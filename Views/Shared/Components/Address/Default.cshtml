@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizerFactory Factory
@{
    var Localizer = Factory.Create("SharedResource", "company_profile");    
}

@model company_profile.ContactVM
@if (Model != null)
{    
        <div class="footer-item">
        <h3>@Localizer["Address"]</h3>
            <div class="footer-address-item">
                <div class="icon"><i class="fa fa-map-marker"></i></div>
                <div class="text">
                <span>@Model.Alamat</span>
                </div>
            </div>
            <div class="footer-address-item">
                <div class="icon"><i class="fa fa-phone"></i></div>
                <div class="text">
                <span>@Model.PhoneNumber</span>
                </div>
            </div>
            <div class="footer-address-item">
                <div class="icon"><i class="fa fa-envelope"></i></div>
                <div class="text">
                <span>@Model.EmailAddress</span>
                </div>
            </div>
            <ul class="footer-social">
            <li><a href=" @Model.UrlFb" target="_blank"><i class="fa fa-facebook"></i></a></li>
            <li><a href=" @Model.UrlTwiter" target="_blank"><i class="fa fa-twitter"></i></a></li>
            <li><a href=" @Model.UrlLinkedIn" target="_blank"><i class="fa fa-linkedin"></i></a></li>
            <li><a href=" @Model.UrlPinterest" target="_blank"><i class="fa fa-pinterest"></i></a></li>
            <li><a href=" @Model.UrlYoutube" target="_blank"><i class="fa fa-youtube"></i></a></li>
            <li><a href=" @Model.UrlInstagram" target="_blank"><i class="fa fa-instagram"></i></a></li>
        </ul>
        </div>
}
else
{
    <li class="text-muted">Data belum ada untuk ditampilkan.</li>
}