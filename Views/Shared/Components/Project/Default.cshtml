@model IEnumerable<company_profile.PortfolioVM>

<ul class="list-unstyled">
    @if (Model != null && Model.Any())
    {
        @foreach (var project in Model)
        {
            <li class="mb-3 d-flex align-items-start">
                @* Foto di sebelah kiri *@
                @if (!string.IsNullOrEmpty(project.UrlGambar))
                {
                    <img src="@project.UrlGambar" alt="Project Image" class="img-thumbnail me-3 flex-shrink-0"
                         style="width: 60px; height: 60px; object-fit: cover;" />
                }
                else
                {
                    <img src="/uploads/no-image.png" alt="No Image" class="img-thumbnail me-3 flex-shrink-0"
                         style="width: 60px; height: 60px; object-fit: cover;" />
                }

                @* Judul di sebelah kanan *@
                <div class="flex-grow-1">
                    <a href="@Url.Action("PortfolioDetail", "Company", new { Id = project.IDPortfolio })"
                       class="text-decoration-none fw-semibold text-dark d-block lh-sm mb-1">
                        @project.Judul
                    </a>
                </div>
            </li>
        }
    }
    else
    {
        <li class="text-muted">Tidak ada portfolio terbaru.</li>
    }
</ul>