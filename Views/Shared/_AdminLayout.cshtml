                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item" asp-action="ChangePassword" asp-controller="Account">Change Password</a>
                        </li>
                        <li>
                            <form asp-action="Logout" asp-controller="Account" method="post" class="d-inline">
