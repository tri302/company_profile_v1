@model company_profile.ContactFormVM

@{
    ViewData["Title"] = "Pesan Detail";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fa fa-envelope-open-text me-2"></i> Detail Pesan Masuk</h5>
                </div>
                
                <div class="card-body p-4">
                    <div class="row mb-4">
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase fw-bold">Nama Pengirim</label>
                            <p class="fs-5 fw-semibold text-primary">@Model.Name</p>
                        </div>
                        <div class="col-sm-6 text-sm-end">
                            <label class="text-muted small text-uppercase fw-bold">Status</label>
                            <div>
                                <span class="badge bg-success">Diterima</span>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4">
                        <div class="col-sm-6">
                            <label class="text-muted small text-uppercase fw-bold"><i class="fa fa-phone me-1"></i> Nomor Telepon</label>
                            <p>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</p>
                        </div>
                        <div class="col-sm-6 text-sm-start text-sm-end">
                            <label class="text-muted small text-uppercase fw-bold"><i class="fa fa-envelope me-1"></i> Alamat Email</label>
                            <p><a href="mailto:@Model.EmailAddress" class="text-decoration-none">@Model.EmailAddress</a></p>
                        </div>
                    </div>

                    <hr class="text-muted">

                    <div class="mb-4">
                        <label class="text-muted small text-uppercase fw-bold">Subjek</label>
                        <p class="fw-bold">@Model.Subject</p>
                    </div>

                    <div class="mb-4">
                        <label class="text-muted small text-uppercase fw-bold">Isi Pesan</label>
                        <div class="p-3 bg-light border rounded shadow-sm" style="min-height: 150px; white-space: pre-wrap;">
                            @Model.Pesan
                        </div>
                    </div>
                </div>

                <!-- Footer dengan tata letak Kiri - Kanan -->                
                <div class="card-footer bg-light d-print-none">
                    <div class="d-flex align-items-center w-100">
                        <!-- Tombol Kembali -->
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="fa fa-arrow-left"></i> Kembali
                        </a>

                        <!-- ms-auto akan memaksa div ini ke ujung kanan container flex -->
                        <div class="ms-auto d-flex gap-2">
                            <button type="button" onclick="window.print()" class="btn btn-outline-primary btn-sm">
                                <i class="fa fa-print"></i> Cetak Pesan
                            </button>
                            <a href="mailto:@Model.EmailAddress?subject=Re: @Model.Subject" class="btn btn-primary btn-sm">
                                <i class="fa fa-reply"></i> Balas Via Email
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <style>
        .card { border-radius: 15px; overflow: hidden; }
        .bg-light { background-color: #f8f9fa !important; }
        label { letter-spacing: 0.5px; }

        /* Sembunyikan tombol saat mencetak (print) */
        @@media print {
            .d-print-none {
                display: none !important;
            }
            .card {
                border: none !important;
                shadow: none !important;
            }
            .container {
                margin-top: 0 !important;
            }
        }
    </style>
}