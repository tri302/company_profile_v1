@model company_profile.PagenationVM.AchievementsListViewModel

@{
    ViewData["Title"] = "Kelola Achievements";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@Html.AntiForgeryToken()

<div class="row page-header" style="margin-bottom: 20px; align-items: center; display: flex; justify-content: space-between;">
    <div class="col-md-6">
        <h2 style="margin: 0; font-weight: 600;">
            <i class="fa fa-dashboard" aria-hidden="true"></i> Manajemen Achievements
        </h2>
        <p class="text-muted" style="margin: 5px 0 0 0;">Kelola data counter statistik dan capaian organisasi.</p>
    </div>
    <div class="col-md-6 text-right" style="text-align: right;">
        <a asp-action="Create" class="btn btn-primary btn-sm" style="font-weight: 500;">
            <i class="fa fa-plus-circle" aria-hidden="true"></i> Create New
        </a>
    </div>
</div>
<hr />
<div id="table-container">
    <partial name="_AchievementsTablePartial" model="Model" />
</div>

@section Scripts {

    <script>
        $(document).ready(function () {
            // Event delegation untuk pagination
            $('#table-container').on('click', 'button.btn:not(.disabled)', function () {
                var targetPage = $(this).data('page');
                $.ajax({
                    url: '@Url.Action("GetPaginatedData", "Achievements")',
                    data: { pageNumber: targetPage },
                    success: function (result) {
                        $('#table-container').html(result);
                    }
                });
            });
        });
    </script>

    <script>
        function deleteData(id) {
            Swal.fire({
                title: 'Apakah anda yakin?',
                text: "Data yang dihapus tidak dapat dikembalikan!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Ya, hapus!',
                cancelButtonText: 'Batal',
                position: 'top',
            }).then((result) => {
                if (result.isConfirmed) {
                    var token = $('input[name="__RequestVerificationToken"]').val();
                    $.ajax({
                        url: '/Achievements/Delete/' + id,
                        headers: {
                            "RequestVerificationToken": token
                        },
                        type: 'POST',
                        success: function (response) {
                            if (response.success) {
                                Swal.fire(
                                    'Deleted!',
                                    response.message,
                                    'success'
                                ).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error!', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error!', 'Terjadi kesalahan sistem.', 'error');
                        }
                    });
                }
            })
        }
    </script>

    <script>
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Sukses!',
                    text: '@TempData["SuccessMessage"]',
                    position: 'top',
                    timer: 5000,
                    showConfirmButton: false
                });
            </text>
        }
    </script>

    <script>
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Gagal!',
                    text: '@TempData["ErrorMessage"]',
                    position: 'top',
                    timer: 5000,
                    showConfirmButton: false
                });
            </text>
        }
    </script>
}