@using company_profile.ViewModels
@model LoginViewModel
@{
    Layout = null;
}

<head>    
    <link href="~/font-awesome/css/all.min.css" rel="stylesheet" />    
    <link rel="stylesheet" href="~/css/adminlte.css" asp-append-version="true" />
    <style>
        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            border-radius: 15px !important;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2) !important;
            overflow: hidden;
            transition: transform 0.3s ease;
        }

            .login-card:hover {
                transform: translateY(-5px);
            }

        .btn-primary {
            background: #764ba2 !important;
            border: none !important;
            transition: 0.3s;
        }

            .btn-primary:hover {
                background: #5a377d !important;
            }

        .input-group-text {
            background: #f8f9fa;
            border-right: none;
        }

        .form-control {
            border-left: none;
        }
    </style>
</head>

<div class="login-box animate__animated animate__fadeIn">
    <div class="card login-card">
        <div class="card-body login-card-body p-4">
            <div class="text-center mb-4">
                <i class="fa-solid fa-circle-user fa-4x text-primary mb-3"></i>
                <h3 class="fw-bold">Welcome Back</h3>
                <p class="text-muted">Sign in to continue</p>
            </div>

            <form asp-action="Login" asp-controller="Account" method="post">
                <div class="input-group mb-3">
                    <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                    <div class="form-floating">
                        <input asp-for="Email" class="form-control" id="email" placeholder="Email">
                        <span asp-validation-for="Email" class="text-danger"></span>
                        <label for="email">Email Address</label>
                    </div>
                </div>

                <div class="input-group mb-3">
                    <span class="input-group-text"><i class="fa fa-lock"></i></span>
                    <div class="form-floating">
                        <input asp-for="Password" class="form-control" id="password" placeholder="Password">
                        <label for="password">Password</label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <!-- Tombol Mata -->
                    <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                        <i class="fa fa-eye" id="eyeIcon"></i>
                    </button>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="remember">
                        <label class="form-check-label" for="remember">Remember Me</label>
                    </div>
                    @* <a asp-action="ForgotPassword" class="text-decoration-none small">Forgot password?</a> *@
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg">Sign In</button>
                </div>
            </form>
        </div>
    </div>
</div>
<link href="~/sweetalert2/sweetalert2.min.css" rel="stylesheet" />
<script src="~/sweetalert2/sweetalert2.min.js"></script>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>
    // Cek apakah ada pesan error dari controller
    @if (TempData["ErrorMessage"] != null)
    {
        <text>
            Swal.fire({
                icon: 'error',
                title: 'Gagal Login',
                text: '@TempData["ErrorMessage"]',
                confirmButtonColor: '#2563eb', // Sesuai warna biru tailwind Anda
                confirmButtonText: 'Coba Lagi',
                position:'top'
            });
        </text>
    }
</script>

<script>
    const togglePassword = document.querySelector('#togglePassword');
    const password = document.querySelector('#password');
    const eyeIcon = document.querySelector('#eyeIcon');

    togglePassword.addEventListener('click', function (e) {
        // Toggle tipe input
        const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
        password.setAttribute('type', type);

        // Toggle ikon mata
        eyeIcon.classList.toggle('fa-eye');
        eyeIcon.classList.toggle('fa-eye-slash');
    });
</script>

@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}