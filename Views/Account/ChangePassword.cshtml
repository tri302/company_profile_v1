@using company_profile.ViewModels
@model ChangePasswordViewModel
@{
    Layout = null;
}
<head>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="~/font-awesome/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/adminlte.css" asp-append-version="true" />
    </head>
<body>
        <div class="min-h-screen flex items-center justify-center bg-gray-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8 bg-white p-10 rounded-2xl shadow-xl border border-gray-100">
        <div>
            <h2 class="mt-2 text-center text-3xl font-extrabold text-gray-900">
                Ubah Kata Sandi
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                Pastikan kata sandi baru Anda kuat dan unik.
            </p>
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }
        </div>

            <form asp-action="ChangePassword" asp-controller="Account" method="POST" class="mt-8 space-y-6">
                <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm"></div>

                <div class="space-y-4">
                    <div>
                        <label asp-for="CurrentPassword" class="block text-sm font-medium text-gray-700"></label>
                        <div class="relative mt-1">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                                <i class="fas fa-lock"></i>
                            </span>
                            <input asp-for="CurrentPassword" type="password" class="pl-10 block w-full px-3 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500" placeholder="••••••••">
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-red-500 text-xs"></span>
                    </div>

                    <div>
                        <label asp-for="NewPassword" class="block text-sm font-medium text-gray-700"></label>
                        <div class="relative mt-1">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                                <i class="fas fa-key"></i>
                            </span>
                            <input asp-for="NewPassword" type="password" class="pl-10 block w-full px-3 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500" placeholder="••••••••">
                        </div>
                        <span asp-validation-for="NewPassword" class="text-red-500 text-xs"></span>
                    </div>

                    <div>
                        <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700"></label>
                        <div class="relative mt-1">
                            <span class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400">
                                <i class="fas fa-check-circle"></i>
                            </span>
                            <input asp-for="ConfirmPassword" type="password" class="pl-10 block w-full px-3 py-3 border border-gray-300 rounded-lg shadow-sm focus:ring-blue-500 focus:border-blue-500" placeholder="••••••••">
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-red-500 text-xs"></span>
                    </div>
                </div>

                <button type="submit" class="w-full flex justify-center py-3 px-4 rounded-lg text-white bg-blue-600 hover:bg-blue-700 font-medium transition">
                    Simpan Perubahan
                </button>
            </form>
    </div>
</div>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
@{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
}
</body>