@model IEnumerable<company_profile.ViewModels.BannerHomeVM>

@{
    ViewData["Title"] = "Daftar Banner Home";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Daftar Banner Home</h2>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa fa-plus-circle"></i> Create New
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 vertical-align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th class="align-middle" style="width: 50px;">ID</th>
                            <th class="align-middle">Judul Teks Animasi</th>
                            <th class="align-middle">Isi Teks Animasi</th>
                            <th class="align-middle" style="width: 150px;">Preview Gambar</th>
                            <th class="align-middle text-center" style="width: 220px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>
                                        <div class="mb-1">
                                            <span class="badge bg-secondary me-1">ID</span> 
                                            <span class="text-wrap">@item.JudulTextAnimatedOnBanner_ID</span>
                                        </div>
                                        <div>
                                            <span class="badge bg-dark me-1">EN</span> 
                                            <span class="text-wrap text-muted">@item.JudulTextAnimatedOnBanner_EN</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="mb-1 text-truncate" style="max-width: 300px;" title="@item.IsiTextAnimatedOnBanner_ID">
                                            <span class="badge bg-secondary me-1">ID</span>@Html.Raw(@item.IsiTextAnimatedOnBanner_ID)
                                        </div>
                                        <div class="text-truncate" style="max-width: 300px;" title="@item.IsiTextAnimatedOnBanner_EN">
                                            <span class="badge bg-dark me-1">EN</span> <span class="text-muted">@Html.Raw(@item.IsiTextAnimatedOnBanner_EN)</span>
                                        </div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.UrlGambar))
                                        {
                                            <img src="@item.UrlGambar" alt="Banner Image" class="img-thumbnail"
                                                 style="max-height: 60px; object-fit: cover;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Tidak ada gambar</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">
                                                <i class="fa fa-pencil"></i> Edit
                                            </a>                                            
                                            <button type="button" onclick="deleteData(@item.Id)" class="btn btn-danger btn-sm">
                                                <i class="fa fa-trash"></i> Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">
                                    <i class="fa fa-folder-open display-4 d-block mb-2"></i>
                                    Tidak ada data banner yang tersedia.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteData(id) {
            Swal.fire({
                title: 'Apakah anda yakin?',
                text: "Data yang dihapus tidak dapat dikembalikan!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Ya, hapus!',
                cancelButtonText: 'Batal',
                position: 'top',
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/BannerHome/Delete/' + id,
                        type: 'POST',
                        success: function (response) {
                            if (response.success) {
                                Swal.fire(
                                    'Deleted!',
                                    'position :','top-end',
                                    response.message,
                                    'success'
                                ).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Error!', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error!', 'Terjadi kesalahan sistem.', 'error');
                        }
                    });
                }
            })
        }
    </script>

    <script>
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Sukses!',
                    text: '@TempData["SuccessMessage"]',
                    position: 'top-end',
                    timer: 5000,
                    showConfirmButton: false
                });
            </text>
        }
    </script>

    <script>
        @if (TempData["ErrorMessage"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'error',
                    title: 'Error!',
                    text: '@TempData["ErrorMessage"]',
                    position: 'top',
                    timer: 5000,
                    showConfirmButton: false
                });
            </text>
        }
    </script>
}