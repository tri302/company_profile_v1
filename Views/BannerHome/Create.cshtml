@model company_profile.ViewModels.BannerHomeVM
@{
    ViewData["Title"] = "Tambah Banner Baru";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<style>
    .ck-editor__editable_inline {
        min-height: 250px;
    }
</style>
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Form Tambah Banner Home</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="col-lg-8-md-12 mb-4">
                            <ul class="nav nav-tabs" id="langTabs" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active fw-bold text-primary" id="id-tab" data-bs-toggle="tab" data-bs-target="#langID" type="button" role="tab">
                                        🇮🇩 Bahasa Indonesia
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link fw-bold text-success" id="en-tab" data-bs-toggle="tab" data-bs-target="#langEN" type="button" role="tab">
                                        🇬🇧 English
                                    </button>
                                </li>
                            </ul>
                            <div class="tab-content border border-top-0 p-3 bg-light rounded-bottom" id="langTabsContent">
                                <div class="tab-pane fade show active" id="langID" role="tabpanel">
                                    <div class="col-md-12 mb-3">
                                        <label asp-for="JudulTextAnimatedOnBanner_ID" class="form-label fw-bold">Judul Teks Animasi (ID)</label>
                                        <textarea asp-for="JudulTextAnimatedOnBanner_ID" class="form-control" rows="3"
                                                  placeholder="Masukkan judul dalam Bahasa Indonesia..." ></textarea>
                                        <span asp-validation-for="JudulTextAnimatedOnBanner_ID" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-12 mb-3">
                                        <label asp-for="IsiTextAnimatedOnBanner_ID" class="form-label fw-bold">Isi Teks Animasi (ID)</label>                                        
                                        <textarea asp-for="IsiTextAnimatedOnBanner_ID" id="editor_ID" class="form-control" rows="5"
                                                  placeholder="Masukkan detail isi dalam Bahasa Indonesia..."></textarea>
                                        <span asp-validation-for="IsiTextAnimatedOnBanner_ID" class="text-danger small"></span>
                                    </div>
                                </div>

                                <div class="tab-pane fade" id="langEN" role="tabpanel">
                                    <div class="col-md-12 mb-3">
                                        <label asp-for="JudulTextAnimatedOnBanner_EN" class="form-label fw-bold">Judul Teks Animasi (EN)</label>
                                        <textarea asp-for="JudulTextAnimatedOnBanner_EN" class="form-control" rows="3"
                                                  placeholder="Masukkan judul dalam Bahasa Inggris..."></textarea>
                                        <span asp-validation-for="JudulTextAnimatedOnBanner_EN" class="text-danger small"></span>
                                    </div>
                                    <div class="col-md-12 mb-3">
                                        <label asp-for="IsiTextAnimatedOnBanner_EN" class="form-label fw-bold">Isi Teks Animasi (EN)</label>                                        
                                        <textarea asp-for="IsiTextAnimatedOnBanner_EN" id="editor_EN" class="form-control" rows="5"
                                                  placeholder="Masukkan detail isi dalam Bahasa Inggris..."></textarea>
                                        <span asp-validation-for="IsiTextAnimatedOnBanner_EN" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="mt-3 p-2 border rounded bg-light d-none mb-2" id="previewContainer">
                                <span class="d-block text-muted small mb-1 fw-bold">Live Preview Gambar:</span>
                                <img id="imgPreview" src="" alt="Preview" class="img-fluid rounded border"
                                     style="max-height: 150px; object-fit: cover;" />
                            </div>

                            <label class="form-label fw-bold">Upload Gambar Banner</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa fa-link"></i></span>
                                <input asp-for="file" type="file" accept="image/*" class="form-control" id="fileGambarInput" />
                                <span asp-validation-for="file" class="text-danger small"></span>
                            </div>
                            <span id="validationError" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between border-top pt-3">
                            <a asp-action="Index" class="btn btn-sm btn-secondary">
                                <i class="fa fa-arrow-left"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-primary btn-sm">
                                <i class="fa fa-save"></i> Simpan Data
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
            document.addEventListener("DOMContentLoaded", function () {
                // Pastikan CKEditor sudah dimuat di window
                if (typeof ClassicEditor !== 'undefined') {
                    const targetEditors = ['#editor_ID', '#editor_EN'];

                    targetEditors.forEach(selector => {
                        const editorElement = document.querySelector(selector);

                        if (editorElement) {
                            ClassicEditor
                                .create(editorElement)
                                .then(editor => {
                                    // Update field asli saat ada perubahan
                                    editor.model.document.on('change:data', () => {
                                        editorElement.value = editor.getData();
                                        // Validasi jika menggunakan jQuery Validate
                                        if (typeof $ !== 'undefined' && $.fn.valid) {
                                            $(editorElement).valid();
                                        }
                                    });
                                })
                                .catch(error => {
                                    console.error('CKEditor Gagal Inisialisasi pada ' + selector, error);
                                });
                        }
                    });
                } else {
                    console.error('CKEditor library tidak ditemukan.');
                }
            });
            // Izinkan elemen tersembunyi (seperti textarea CKEditor) untuk divalidasi oleh jQuery Validate
        if ($.validator) {
         $.validator.setDefaults({ ignore: [] });
        }
    </script>

    <script>
        const fileInput = document.getElementById('fileGambarInput');
        const previewContainer = document.getElementById('previewContainer');
        const imgPreview = document.getElementById('imgPreview');
        const errorSpan = document.getElementById('validationError');

        const MAX_SIZE_MB = 2;
        const ALLOWED_TYPES = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];

        fileInput.addEventListener('change', function () {
            const file = this.files[0];
            errorSpan.textContent = '';

            if (file) {
                // 1. Validasi Tipe File
                if (!ALLOWED_TYPES.includes(file.type)) {
                    errorSpan.textContent = 'Format file tidak didukung! Pilih gambar (JPG, PNG, WEBP, GIF).';
                    resetPreview();
                    return;
                }

                // 2. Validasi Ukuran File
                if (file.size > MAX_SIZE_MB * 1024 * 1024) {
                    errorSpan.textContent = `Ukuran file terlalu besar! Maksimal adalah ${MAX_SIZE_MB} MB.`;
                    resetPreview();
                    return;
                }

                const objectUrl = URL.createObjectURL(file);
                imgPreview.src = objectUrl;
                previewContainer.classList.remove('d-none');

                imgPreview.onload = function () {
                    URL.revokeObjectURL(objectUrl);
                };

            } else {
                resetPreview();
            }
        });

        function resetPreview() {
            previewContainer.classList.add('d-none');
            imgPreview.src = '';
            fileInput.value = '';
        }
    </script>
}