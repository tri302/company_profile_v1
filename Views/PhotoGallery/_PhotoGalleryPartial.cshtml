@model company_profile.PhotoGalleryVM

<div class="row">
    @if (Model != null && Model.ListOurPhotoGallery.Any())
    {
        foreach (var item in Model.ListOurPhotoGallery)
        {
            <div class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="card h-100 shadow-sm border-0 gallery-card">
                    @* Area Gambar *@
                    <div class="position-relative overflow-hidden">
                        <img src="@item.UrlGambar" class="card-img-top img-gallery"
                             style="height: 200px; object-fit: cover;" alt="Gallery Image">
                    </div>

                    @* Tombol Aksi di Bawah Foto *@
                    <div class="card-body p-2">
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.IDPhotoGallery"
                               class="btn btn-outline-warning btn-sm w-100">
                                <i class="fa fa-edit"></i> Edit
                            </a>
                            <button onclick="deletePhoto(@item.IDPhotoGallery)" class="btn btn-outline-danger btn-sm w-100">
                                <i class="fa fa-trash"></i> Hapus
                            </button>
                        </div>
                        @* Tanggal Upload *@
                        <small class="text-muted text-center d-block mt-2">
                            <i class="fa fa-calendar-alt"></i>Uploaded : @item.CreateAt.ToString("dd MMM yyyy")
                        </small>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center py-5">
            <p class="text-muted">No photos found in gallery.</p>
        </div>
    }
</div>
<div class="d-flex justify-content-center align-items-center mt-3 gap-3" id="pagination-controls">
    <button id="btn-prev" class="btn btn-primary btn-sm @(Model.CurrentPage <= 1 ? "disabled" : "")"
            data-page="@(Model.CurrentPage - 1)">
        <i class="fa fa-arrow-left"></i>
        Previous
    </button>

    <span class="text-muted fw-bold">Page @Model.CurrentPage of @Model.TotalPages</span>

    <button id="btn-next" class="btn btn-warning btn-sm @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
            data-page="@(Model.CurrentPage + 1)">
        Next
        <i class="fa fa-arrow-right"></i>
    </button>
</div>