@using company_profile.PagenationVM
@model SliderFooterListViewModel
<!-- Main Content -->
<section class="content">
    <div class="container-fluid">
        <div class="card card-outline card-primary shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-striped m-0 vertical-align-middle">
                        <thead class="thead-light">
                            <tr>
                                @* <th style="width: 80px;" class="text-center">ID</th> *@
                                <th style="width: 250px;">Preview Gambar</th>
                                <th>File Path / URL</th>
                                <th style="width: 180px;" class="text-center">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items != null && Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    <tr>
                                        @* <td class="text-center font-weight-bold text-muted">@item.Id</td> *@
                                        <td>
                                            @if (!string.IsNullOrEmpty(item.UrlImage))
                                            {
                                                <div class="thumbnail-wrapper img-thumbnail bg-light d-flex align-items-center justify-content-center"
                                                     style="width: 180px; height: 100px; overflow: hidden;">
                                                    <img src="~/uploads/sliders/@item.UrlImage" alt="Slider Image" class="img-fluid"
                                                         style="max-height: 100%; max-width: 100%; object-fit: cover;" />
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted small text-center p-3 bg-light rounded"
                                                     style="width: 180px;">
                                                    <i class="fa fa-picture-o fa-2x d-block mb-1 text-secondary"
                                                       aria-hidden="true"></i> Tidak ada gambar
                                                </div>
                                            }
                                        </td>
                                        <td class="align-middle">
                                            <code class="text-break">@item.UrlImage</code>
                                        </td>
                                        <td class="text-center align-middle">
                                            <div class="btn-group" role="group">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning"
                                                   title="Ubah Data">
                                                    <i class="fa fa-pencil" aria-hidden="true"></i> Edit
                                                </a>
                                                <button onclick="deleteSliderFooter(@item.Id)" class="btn btn-danger btn-sm">
                                                    <i class="fa fa-trash"></i> Delete
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-5 text-muted">
                                        <i class="fa fa-folder-open-o fa-3x d-block mb-2" aria-hidden="true"></i>
                                        <span>Belum ada data slider yang tersedia.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>
<div class="d-flex justify-content-center align-items-center mt-3 gap-3" id="pagination-controls">

    <button id="btn-prev" class="btn btn-primary btn-sm @(Model.CurrentPage <= 1 ? "disabled" : "")"
            data-page="@(Model.CurrentPage - 1)">
        <i class="fa fa-arrow-left"></i>
        Previous
    </button>

    <span class="text-muted fw-bold">Page @Model.CurrentPage of @Model.TotalPages</span>

    <button id="btn-next" class="btn btn-warning btn-sm @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")"
            data-page="@(Model.CurrentPage + 1)">
        Next
        <i class="fa fa-arrow-right"></i>
    </button>
</div>