@model company_profile.PricingVM
@{
    ViewData["Title"] = "Pricing Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";    
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0"><i class="fa fa-tags text-primary me-2"></i> Pricing Management</h2>
            <small class="text-muted">Kelola paket harga layanan perusahaan dalam Multi-Bahasa (ID / EN)</small>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm shadow-sm">
            <i class="fa fa-plus-circle me-1"></i> Create New
        </a>
    </div>
    <div id="table-container">
        <partial name="_PricingPartial.cshtml" model="Model" />
    </div>    
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Event delegation untuk pagination
            $('#table-container').on('click', 'button.btn:not(.disabled)', function () {
                var targetPage = $(this).data('page');
                $.ajax({
                    url: '@Url.Action("GetPaginatedData", "Pricing")',
                    data: { pageNumber: targetPage },
                    success: function (result) {
                        $('#table-container').html(result);
                    }
                });
            });
        });
    </script>
    <script>
        function deletePricing(id) {
            Swal.fire({
                title: 'Hapus paket harga?',
                text: "Layanan ini tidak akan muncul lagi di halaman utama website.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fa fa-trash"></i> Ya, Hapus',
                cancelButtonText: 'Batal',
                position: 'top',
                customClass: {
                    popup: 'position-absolute top-0 start-50 translate-middle-x mt-3'
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    // Tampilkan loading state saat memproses
                    Swal.fire({
                        title: 'Memproses...',
                        didOpen: () => { Swal.showLoading(); },
                        allowOutsideClick: false,
                        position: 'top'
                    });

                    $.ajax({
                        url: '@Url.Action("Delete", "Pricing")/' + id,
                        type: 'POST',
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Terhapus!',
                                    text: res.message || 'Paket harga berhasil dihapus.',
                                    position: 'top',
                                    timer: 2000,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Gagal!',
                                    text: res.message || 'Terjadi kesalahan sistem saat menghapus data.',
                                    position: 'top'
                                });
                            }
                        },
                        error: function () {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error!',
                                text: 'Gagal menghubungi server. Periksa koneksi Anda.',
                                position: 'top'
                             });
                        }
                    });
                }
            });
        }
    </script>
    
    <script>
        // Menampilkan pemberitahuan Toast/Alert setelah operasi Redirect sukses
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Sukses!',
                    text: '@Html.Raw(TempData["SuccessMessage"])',
                    position: 'top',
                    timer: 4000,
                    showConfirmButton: false,
                    toast: false
                });
            </text>
        }
    </script>
}