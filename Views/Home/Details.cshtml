@using company_profile.ViewModels.HomeVM
@model HomeVM

@{
    ViewData["Title"] = "Detail Konten Beranda";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 mt-4 mb-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h4 class="mb-1 text-dark fw-bold">Detail Konten Beranda</h4>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 small">
                    <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Beranda</a></li>
                    <li class="breadcrumb-item active fw-medium" aria-current="page">Detail Konten</li>
                </ol>
            </nav>
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">
                <i class="fa fa-pencil-square-o"></i> Edit Data Konten
            </a>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7 d-flex flex-column gap-4">
            
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary p-2 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="fa fa-info-circle fa-lg"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-dark">Informasi About Start</h6>
                        <small class="text-muted">Judul utama dan konten deskripsi profil.</small>
                    </div>
                </div>
                <div class="card-body p-4">
                    <div class="mb-4">
                        <label class="text-uppercase text-muted fw-bold small mb-2" style="letter-spacing: 0.5px;">Judul About Start</label>
                        <h5 class="fw-bold text-dark mb-0">Judul About Start</h5>
                    </div>
                    
                    <div>
                        <label class="text-uppercase text-muted fw-bold small mb-2" style="letter-spacing: 0.5px;">Isi About Start</label>
                        <p class="text-secondary mb-0 lh-lg" style="white-space: pre-line; text-align: justify;">@Html.Raw(@Model.IsiAboutStart)</p>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 text-success p-2 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="fa fa-tasks fa-lg"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-dark">Item Progress Bar</h6>
                        <small class="text-muted">Metrik capaian yang ditampilkan di halaman depan.</small>
                    </div>
                </div>
                <div class="card-body p-4">
                    @if (Model.ProgressBars != null && Model.ProgressBars.Count > 0)
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var item in Model.ProgressBars)
                            {
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-semibold text-dark small">@item.Judul</span>
                                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1 rounded-pill">@item.Value%</span>
                                    </div>
                                    <div class="progress bg-light shadow-none" style="height: 10px; border-radius: 10px;">
                                        <div class="progress-bar progress-bar-striped progress-bar-animated bg-success rounded-pill" 
                                             role="progressbar"
                                             style="width: @item.Value%;" 
                                             aria-valuenow="@item.Value" 
                                             aria-valuemin="0"
                                             aria-valuemax="100">
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 bg-light rounded-3 border border-dashed">
                            <i class="fa fa-folder-open-o fa-2x mb-2 text-muted opacity-50"></i>
                            <p class="mb-0 text-muted small">Tidak ada item progress bar yang terikat pada data ini.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5 d-flex flex-column gap-4">
            
            @* <div class="card shadow-sm border-0 rounded-4"> *@
            @*     <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center"> *@
            @*         <div class="bg-warning bg-opacity-10 text-warning p-2 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;"> *@
            @*             <i class="fa fa-picture-o fa-lg"></i> *@
            @*         </div> *@
            @*         <div> *@
            @*             <h6 class="mb-0 fw-bold text-dark">Lampiran Gambar</h6> *@
            @*             <small class="text-muted">Visual background untuk seksi utama.</small> *@
            @*         </div> *@
            @*     </div> *@
            @*     <div class="card-body p-4 text-center"> *@
            @*         <div class="position-relative d-inline-block w-100 p-2 bg-light border rounded-3"> *@
            @*             <img src="/uploads/home/@Model.UrlGambar" alt="Gambar Beranda" *@
            @*                  class="img-fluid rounded-2 shadow-sm bg-white" style="max-height: 240px; width: 100%; object-fit: contain; cursor: zoom-in;" *@
            @*                  data-bs-toggle="modal" data-bs-target="#imageZoomModal" *@
            @*                  onerror="this.onerror=null; this.src='/uploads/no-image.png'; this.style.opacity='0.5'; this.style.cursor='default'; this.removeAttribute('data-bs-toggle');" /> *@
            @*         </div> *@
            @*         <small class="text-muted d-block mt-3"><i class="fa fa-search-plus me-1"></i> Klik gambar untuk memperbesar resolusi</small> *@
            @*     </div> *@
            @* </div> *@

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white py-3 px-4 border-bottom d-flex align-items-center">
                    <div class="bg-danger bg-opacity-10 text-danger p-2 rounded-circle me-3 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="fa fa-youtube-play fa-lg"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold text-dark">Integrasi Video</h6>
                        <small class="text-muted">@Html.DisplayNameFor(model => model.EmbededUrlVidio)</small>
                    </div>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.EmbededUrlVidio))
                    {
                        <div class="ratio ratio-16x9 rounded-3 shadow-sm border overflow-hidden bg-dark">
                            @Html.Raw(Model.EmbededUrlVidio)
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-4 bg-light rounded-3 border border-dashed">
                            <i class="fa fa-video-slash fa-2x mb-2 text-muted opacity-50"></i>
                            <p class="mb-0 text-muted small">Tautan integrasi video kosong atau tidak dikonfigurasi.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4 pt-2">
        <a asp-action="Index" class="btn btn-secondary btn-sm">
            <i class="fa fa-arrow-left"></i> Back
        </a>
    </div>
</div>

