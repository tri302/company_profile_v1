@using company_profile.ViewModels.HomeVM
@model HomeVM

@{
    ViewData["Title"] = "Manajemen Beranda";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h4 class="mb-1 text-dark fw-bold">
                <i class="fa fa-home text-primary me-2"></i>Manajemen Konten Beranda
            </h4>
            <p class="text-muted small mb-0">Kelola informasi utama landing page, video profil, dan matriks progress bar dua bahasa.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-sm px-3 shadow-sm text-white fw-medium">
            <i class="fa fa-plus-circle me-1"></i> Create New
        </a>
    </div>
    <div id="table-container">
        <partial name="_HomePartial.cshtml" model="Model" />
    </div>
</div>

<style>
    /* Custom utility styles for enhancement */
    .small-badge {
        font-size: 0.65rem !important;
        padding: 0.2em 0.5em;
    }
    .tracking-wider {
        letter-spacing: 0.05em;
    }
    .btn-white {
        background-color: #fff;
        border: none;
    }
    .btn-white:hover {
        background-color: #f8f9fa;
    }
    .img-hover-zoom {
        overflow: hidden;
        transition: transform .2s;
    }
    .img-hover-zoom:hover {
        transform: scale(1.08);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Event delegation untuk pagination
            $('#table-container').on('click', 'button.btn:not(.disabled)', function () {
                var targetPage = $(this).data('page');
                $.ajax({
                    url: '@Url.Action("GetPaginatedData", "News")',
                    data: { pageNumber: targetPage },
                    success: function (result) {
                        $('#table-container').html(result);
                    }
                });
            });
        });
    </script>
    <script>
        function deleteData(id) {
            Swal.fire({
                title: 'Apakah anda yakin?',
                text: "Data beranda akan dihapus permanen termasuk seluruh item progress bar di dalamnya!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Ya, hapus!',
                cancelButtonText: 'Batal',
                position: 'top',
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '/Home/Delete/' + id,
                        type: 'POST',
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Terhapus!',
                                    text: response.message,
                                    position: 'top',
                                    timer: 2000,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Gagal!', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error!', 'Terjadi kesalahan internal pada sistem.', 'error');
                        }
                    });
                }
            })
        }
    </script>

    <script>
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                Swal.fire({
                    icon: 'success',
                    title: 'Sukses!',
                    text: '@TempData["SuccessMessage"]',
                    position: 'top',
                    timer: 4000,
                    showConfirmButton: false
                });
            </text>
        }        
    </script>
}