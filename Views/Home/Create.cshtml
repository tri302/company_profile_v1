@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Izinkan elemen tersembunyi (seperti textarea CKEditor) untuk divalidasi oleh jQuery Validate
            if ($.validator) {
                $.validator.setDefaults({ ignore: [] });
            }
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Pastikan CKEditor sudah dimuat di window
            if (typeof ClassicEditor !== 'undefined') {
                const targetEditors = ['#editor_ID', '#editor_EN'];

                targetEditors.forEach(selector => {
                    const editorElement = document.querySelector(selector);

                    if (editorElement) {
                        ClassicEditor
                            .create(editorElement)
                            .then(editor => {
                                // Update field asli saat ada perubahan
                                editor.model.document.on('change:data', () => {
                                    editorElement.value = editor.getData();
                                    // Validasi jika menggunakan jQuery Validate
                                    if (typeof $ !== 'undefined' && $.fn.valid) {
                                        $(editorElement).valid();
                                    }
                                });
                            })
                            .catch(error => {
                                console.error('CKEditor Gagal Inisialisasi pada ' + selector, error);
                            });
                    }
                });
            } else {
                console.error('CKEditor library tidak ditemukan.');
            }
        });
    </script>

    <script type="text/javascript">
                $(document).ready(function () {
                    // ==========================================
                    // 1. INPUT PREVIEW & VALIDASI SIZE IMAGES
                    // ==========================================
                    // $("#inputFileGambar").change(function () {
                    //     const fileInput = this;
                    //     const file = fileInput.files[0];
                    //     const maxSize = 2 * 1024 * 1024; 2MB

                    //     if (file) {
                    //         if (file.size > maxSize) {
                    //             $("#fileError").show();
                    //             resetPreview();
                    //             fileInput.value = "";
                    //             return false;
                    //         } else {
                    //             $("#fileError").hide();
                    //         }

                    //         const reader = new FileReader();
                    //         reader.onload = function (e) {
                    //             $("#imgPreview").attr("src", e.target.result).show();
                    //             $("#previewPlaceholder").hide();
                    //         }
                    //         reader.readAsDataURL(file);
                    //     } else {
                    //         resetPreview();
                    //     }
                    // });

                    // function resetPreview() {
                    //     $("#imgPreview").attr("src", "#").hide();
                    //     $("#previewPlaceholder").show();
                    // }

                    // ==========================================
                    // 2. MODAL INTERAKSI ZOOM IN OUT
                    // ==========================================
                    // $(document).on("click", ".btn-zoom", function (e) {
                    //     e.preventDefault();
                    //     const srcGambar = $(this).attr("src");

                    //     if (srcGambar && srcGambar !== "#") {
                    //         $("#imgModalTarget").attr("src", srcGambar);
                    //         if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    //             var myModal = new bootstrap.Modal(document.getElementById('imageZoomModal'));
                    //             myModal.show();
                    //         } else {
                    //             $("#imageZoomModal").modal("show");
                    //         }
                    //     }
                    // });

                    // ==========================================
                    // 3. VALIDASI FORM URL VIDEO EMBED
                    // ==========================================
                    $("#inputEmbed").on("input blur", function () {
                        validateEmbedUrl($(this).val());
                    });

                    function validateEmbedUrl(url) {
                        if (url.trim() === "") {
                            $("#embedError").hide();
                            return true;
                        }
                        const isEmbed = url.includes("/embed/") || url.includes("player.vimeo.com/video/");
                        if (!isEmbed) {
                            $("#embedError").show();
                            return false;
                        } else {
                            $("#embedError").hide();
                            return true;
                        }
                    }

                    // ==========================================
                    // 4. PROGRESS BAR INTERACTION DINAMIS
                    // ==========================================
                    let indeksProgress = $(".baris-progress").length;

                    $("#btnTambahProgress").click(function () {
                        let htmlBaru = `<div class="row g-2 pb-2 baris-progress align-items-center bg-white p-2 rounded border shadow-sm">
        <input type="hidden" name="ProgressBars[${indeksProgress}].Id" value="0" />
        <div class="col-md-4">
        <div class="input-group input-group-sm border rounded">
        <span class="input-group-text bg-light border-0">ID</span>
        <input type="text" name="ProgressBars[${indeksProgress}].Judul_ID" class="form-control border-0 input-judul-id" placeholder="Nama Keahlian (ID)" required />
        </div>
        </div>
        <div class="col-md-4">
        <div class="input-group input-group-sm border rounded">
        <span class="input-group-text bg-light border-0">EN</span>
        <input type="text" name="ProgressBars[${indeksProgress}].Judul_EN" class="form-control border-0 input-judul-en" placeholder="Skill Name (EN)" required />
        </div>
        </div>
        <div class="col-md-2">
        <div class="input-group input-group-sm border rounded">
        <span class="input-group-text bg-light border-0"><i class="fa fa-percent text-muted"></i></span>
        <input type="number" name="ProgressBars[${indeksProgress}].Value" class="form-control border-0 input-value" min="0" max="100" placeholder="Nilai" required />
        </div>
        </div>
        <div class="col-md-2 text-center">
        <button type="button" class="btn btn-outline-danger btn-sm btnHapusBaris w-100">
        <i class="fa fa-trash"></i>
        </button>
        </div>
        </div>`;
        $("#containerProgress").append(htmlBaru);
        indeksProgress++;
        });

                    $(document).on("click", ".btnHapusBaris", function () {
                        if ($(".baris-progress").length > 1) {
                            $(this).closest(".baris-progress").remove();

                            // Re-index ulang name attributes agar urut untuk model binding .NET
                            $(".baris-progress").each(function (index) {
                                $(this).find("input[type='hidden']").attr("name", `ProgressBars[${index}].Id`);
                                $(this).find(".input-judul-id").attr("name", `ProgressBars[${index}].Judul_ID`);
                                $(this).find(".input-judul-en").attr("name", `ProgressBars[${index}].Judul_EN`);
                                $(this).find(".input-value").attr("name", `ProgressBars[${index}].Value`);
                            });

                            indeksProgress = $(".baris-progress").length;
                        } else {
                            Swal.fire({
                                icon: 'info',
                                title: 'Minimal 1 Item',
                                text: 'Anda harus menyisakan minimal satu baris metrik keahlian!',
                                position: 'top',
                                confirmButtonColor: '#3085d6'
                            });
                        }
                    });

                    // ==========================================
                    // 5. INTERCEPT PRE-SUBMIT CHECK
                    // ==========================================
                    $("#formCreateHome").submit(function (e) {
                        let isValid = true;
                        // Validasi Berkas Gambar Wajib Ada
                        // const fileInput = $("#inputFileGambar")[0];
                        // if (!fileInput.files || fileInput.files.length === 0) {
                        //     e.preventDefault();
                        //     $("#inputFileGambar").focus();
                        //     Swal.fire({
                        //         icon: 'warning',
                        //         title: 'Gambar Utama Kosong',
                        //         text: 'Silakan lampirkan gambar banner terlebih dahulu!',
                        //         position: 'top',
                        //         confirmButtonColor: '#3085d6'
                        //     });
                        //     return false;
                        // }

                        // Validasi Baris Progress Terisi Lengkap
                        $(".baris-progress").each(function () {
                            const inputJudulID = $(this).find(".input-judul-id");
                            const inputJudulEN = $(this).find(".input-judul-en");
                            const inputValue = $(this).find(".input-value");

                            if (inputJudulID.val().trim() === "" || inputJudulEN.val().trim() === "" || inputValue.val().trim() === "") {
                                e.preventDefault();
                                isValid = false;

                                if (inputJudulID.val().trim() === "") { inputJudulID.focus(); }
                                else if (inputJudulEN.val().trim() === "") { inputJudulEN.focus(); }
                                else { inputValue.focus(); }

                                Swal.fire({
                                    icon: 'warning',
                                    title: 'Data Belum Lengkap',
                                    text: 'Seluruh input (ID, EN, dan Nilai) pada item Progress Bar harus diisi!',
                                    position: 'top',
                                    confirmButtonColor: '#3085d6'
                                });
                                return false; // Break loop
                            }
                        });

                        if (!isValid) return false;

                        // Validasi Kelayakan Tautan Video Embed
                        const embedUrl = $("#inputEmbed").val();
                        if (!validateEmbedUrl(embedUrl)) {
                            e.preventDefault();
                            $("#inputEmbed").focus();
                            Swal.fire({
                                icon: 'warning',
                                title: 'URL Embed Tidak Valid',
                                text: 'Silakan periksa kembali tautan video atau kosongkan jika tidak ingin disematkan.',
                                position: 'top',
                                confirmButtonColor: '#3085d6'
                            });
                            return false;
                        }
                    });
                });
    </script>
}
