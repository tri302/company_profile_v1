@using company_profile.ViewModels.HomeVM;
@model HomeVM
@{
    ViewData["Title"] = "Tambah Konten Beranda Baru";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<style>
    .ck-editor__editable_inline {
        min-height: 250px;
    }
    .tracking-wide {
        letter-spacing: 0.04em;
    }

    .x-small {
        font-size: 0.78rem;
    }

    .line-height-1 {
        line-height: 1;
    }

    .border-dashed {
        border-style: dashed !important;
    }

    .shadow-inner {
        box-shadow: inset 0 2px 4px rgba(0, 0, 0, 0.04);
    }
</style>
<div class="container-fluid mt-4" style="max-width: 1000px;">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h4 class="mb-1 text-dark fw-bold">
                <i class="fa fa-plus-circle text-primary me-2"></i>Tambah Data Konten
                Beranda
            </h4>
            <p class="text-muted small mb-0">
                Isi data formulir di bawah ini untuk menambahkan slot landing page baru.
            </p>
        </div>
    </div>
    <div class="card shadow border-0 rounded-3 overflow-hidden">
        <div class="card-body p-4 p-md-5">
            <form asp-action="Create" asp-controller="Home" method="post" enctype="multipart/form-data"
                  id="formCreateHome">                
                <!-- Nav Tabs -->
                <ul class="nav nav-tabs mb-3" id="langTab" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#id-tab"
                                type="button">
                            🇮🇩 Bahasa Indonesia
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#en-tab"
                                type="button">
                            🇺🇸 English
                        </button>
                    </li>
                </ul>
                <div class="tab-content mb-4">
                    <!-- Tab Indonesia -->
                    <div class="tab-pane fade show active" id="id-tab">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="JudulAboutStart_ID"
                                       class="form-label fw-semibold text-secondary small text-uppercase">
                                    Judul Section
                                    (ID)
                                </label>
                                <input asp-for="JudulAboutStart_ID" class="form-control"
                                       placeholder="Contoh: Menuju Era Digital..." />
                                <span asp-validation-for="JudulAboutStart_ID" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="IsiAboutStart_ID"
                                       class="form-label fw-semibold text-secondary small text-uppercase">
                                    Deskripsi
                                    (ID)
                                </label>                                
                                <textarea asp-for="IsiAboutStart_ID" class="form-control" id="editor_ID" rows="4"></textarea>
                                <span asp-validation-for="IsiAboutStart_ID" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Tab English -->
                    <div class="tab-pane fade" id="en-tab">
                        <div class="row g-4">
                            <div class="col-md-6">
                                <label asp-for="JudulAboutStart_EN"
                                       class="form-label fw-semibold text-secondary small text-uppercase">
                                    Title Section
                                    (EN)
                                </label>
                                <input asp-for="JudulAboutStart_EN" class="form-control"
                                       placeholder="Example: Toward Digital Era..." />
                                <span asp-validation-for="JudulAboutStart_EN" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="IsiAboutStart_EN"
                                       class="form-label fw-semibold text-secondary small text-uppercase">
                                    Description
                                    (EN)
                                </label>                               
                                <textarea asp-for="IsiAboutStart_EN" id="editor_EN" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="IsiAboutStart_EN" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>
                <hr class="my-4" />

                <!-- Progress Bar (Global Section) -->
                <!-- Metrik Kemajuan -->
                <div class="mb-5">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="text-dark fw-bold mb-0">
                            <i class="fa fa-tasks text-warning me-2"></i>Metrik Kemajuan
                        </h5>
                        <button type="button" id="btnTambahProgress" class="btn btn-warning btn-sm shadow-sm">
                            <i class="fa fa-plus me-1"></i> Tambah Item
                        </button>
                    </div>

                    <!-- Container Utama -->
                    <div id="containerProgress" class="d-flex flex-column gap-3">
                        @if (Model?.ProgressBars != null && Model.ProgressBars.Count > 0)
                        {
                            @for (int i = 0; i < Model.ProgressBars.Count; i++)
                            {
                                <div class="row g-2 align-items-center bg-white p-3 rounded border shadow-sm baris-progress">
                                    <input type="hidden" name="ProgressBars[@i].Id" value="@Model.ProgressBars[i].Id" />

                                    <div class="col-md-4">
                                        <input type="text"
                                               name="ProgressBars[@i].Judul_ID"
                                               value="@Model.ProgressBars[i].Judul_ID"
                                               class="form-control input-judul-id"
                                               placeholder="Judul Progres (ID)"
                                               required />
                                    </div>

                                    <div class="col-md-4">
                                        <input type="text"
                                               name="ProgressBars[@i].Judul_EN"
                                               value="@Model.ProgressBars[i].Judul_EN"
                                               class="form-control input-judul-en"
                                               placeholder="Judul Progres (EN)"
                                               required />
                                    </div>

                                    <div class="col-md-2">
                                        <input type="number"
                                               name="ProgressBars[@i].Value"
                                               value="@Model.ProgressBars[i].Value"
                                               class="form-control input-value"
                                               placeholder="%"
                                               min="0"
                                               max="100"
                                               required />
                                    </div>
                                    <div class="col-md-2 text-center">
                                        <button type="button"
                                                class="btn btn-outline-danger w-100 btnHapusBaris">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </div>
                                </div>

                            }
                        }
                        else
                        {
                            <!-- FALLBACK: Baris kosong pertama -->
                            <div class="row g-2 align-items-center bg-white p-3 rounded border shadow-sm baris-progress">
                                <input type="hidden" name="ProgressBars[0].Id" value="0" />
                                <div class="col-md-4">
                                    <input type="text"
                                           name="ProgressBars[0].Judul_ID"
                                           class="form-control input-judul-id" placeholder="Judul Progres (ID)" />
                                </div>
                                <div class="col-md-4">
                                    <input type="text"
                                           name="ProgressBars[0].Judul_EN"
                                           class="form-control input-judul-en" placeholder="Judul Progres (EN)" />
                                </div>
                                <div class="col-md-2">
                                    <input type="number"
                                           name="ProgressBars[0].Value"
                                           class="form-control input-value" placeholder="%" min="0" max="100" />
                                </div>
                                <div class="col-md-2 text-center">
                                    <button type="button"
                                            class="btn btn-outline-danger w-100 btnHapusBaris">
                                        <i class="fa fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <!-- Media Section -->
                <div class="mb-4">
                    <h5 class="text-dark fw-bold mb-3">
                        <i class="fa fa-film text-danger me-2"></i>Integrasi Media
                    </h5>
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="EmbededUrlVidio" class="form-label">URL Embed Video</label>
                            <input asp-for="EmbededUrlVidio" id="inputEmbed" class="form-control" />
                            <span asp-validation-for="EmbededUrlVidio" class="text-danger"></span>
                            <div id="embedError"
                                 class="alert alert-danger mt-2"
                                 style="display:none">
                                URL harus berupa URL embed Youtube atau Vimeo.
                            </div>
                            <div class="card bg-light border-start border-4 border-info mt-3 shadow-none">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold text-dark small mb-1">
                                        <i class="fa fa-info-circle text-info me-1">
                                        </i>Cara Menyalin URL Embed:
                                    </h6>
                                    <ol class="small text-secondary mb-0 ps-3">
                                        <li>
                                            Buka video di Youtube, tekan tombol <strong>Bagikan / Share</strong>.
                                        <li>
                                        <li>
                                            Pilih opsi berlambang kode
                                            <strong>Sematkan / Embed (&lt;&gt;)</strong>.
                                        </li>
                                        <li>
                                            Salin teks tautan yang berada di dalam atribut
                                            <code class="text danger">
                                                src="..."
                                            </code> saja.
                                        </li>
                                    </ol>
                                </div>
                            </div>
                        </div>

