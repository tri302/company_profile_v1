                        @*         <div class="col-12 mt-3"> *@
                        @*             <span class="form-label fw-semibold text-secondary small text-uppercase tracking-wide d-block mb-2"> *@
                        @*                 Live *@
                        @*                 Preview Gambar *@
                        @*             </span> *@
                        @*             <div class="border rounded-3 p-2 bg-light d-flex align-items-center justify-content-center position-relative shadow-inner mx-auto overflow-hidden text-center" *@
                        @*                  style="min-height: 140px; max-height: 140px; max-width: 240px;"> *@
