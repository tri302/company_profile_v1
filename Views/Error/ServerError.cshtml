@{
    ViewData["Title"] = "Oops! Terjadi Kesalahan";
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --primary: #6366f1;
            --dark: #1e293b;
            --light: #f8fafc;
        }

        body {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            background-color: var(--light);
            color: var(--dark);
        }

        .error-wrapper {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .error-card {
            background: white;
            padding: 3rem;
            border-radius: 24px;
            box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);
            text-align: center;
            max-width: 500px;
            width: 100%;
        }

        .error-image {
            margin-bottom: 2rem;
            animation: float 3s ease-in-out infinite;
        }
        @@keyframes float {
            0%, 100%

        {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-15px);
        }

        }

        h1 {
            font-weight: 600;
            font-size: 1.8rem;
            margin-bottom: 0.5rem;
        }

        p {
            color: #64748b;
            margin-bottom: 2rem;
            line-height: 1.6;
        }

        .btn-group {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .btn {
            padding: 14px;
            border-radius: 12px;
            text-decoration: none;
            font-weight: 500;
            transition: all 0.3s;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
        }

            .btn-primary:hover {
                background: #4f46e5;
                transform: scale(1.02);
            }

        .btn-secondary {
            background: #e2e8f0;
            color: #475569;
        }

            .btn-secondary:hover {
                background: #cbd5e1;
            }
    </style>
</head>
<body>
    <div class="error-wrapper">
        <div class="error-card">
            <div class="error-image" style="font-size: 80px; color: #6366f1; margin-bottom: 10px;">
                <i class="fas fa-exclamation-triangle"></i>
            </div>

            <h1 style="font-size: 1.5rem; color: #1e293b; margin-bottom: 5px; text-transform: uppercase;">
                Error 500
            </h1>
            <p style="font-weight: 600; color: #475569; margin-bottom: 20px;">
                Internal Server Error
            </p>
            <h1>Terjadi Gangguan Teknis</h1>
            <p>Maaf, server kami sedang mengalami kesulitan. Tim teknis kami sedang berupaya memperbaikinya.</p>
            <div class="btn-group">
                <a href="/" class="btn btn-primary">Kembali ke Beranda</a>
                <a href="mailto:support@perusahaan.com" class="btn btn-secondary">Hubungi Support</a>
            </div>
        </div>
    </div>
</body>
</html>