@model IEnumerable<company_profile.KategoriVM>
@{
    ViewData["Title"] = "Daftar Kategori";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-flex justify-content-end align-items-center mb-3">
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="fa fa-plus-circle"></i> Create New
        </a>
    </div>

    <div class="card shadow-sm border-0 border-top border-primary border-4 rounded-3">
        <div class="card-header bg-white py-3 d-flex align-items-center justify-content-between justify-content-end border-bottom">
            <div class="d-flex align-items-center">
                <div class="bg-primary-subtle text-primary p-2 rounded-2 me-3 d-flex align-items-center justify-content-center"
                     style="width: 40px; height: 40px;">
                    <i class="fa fa-tags fa-lg" aria-hidden="true"></i>
                </div>
                <div>
                    <h5 class="mb-0 fw-bold text-dark">Manajemen Kategori Berita</h5>
                    <small class="text-muted">
                        Kelola kategori multi-bahasa (ID/EN) dan pantau total distribusi artikel
                        berita
                    </small>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom text-secondary">
                        <tr>
                            <th class="ps-4 py-3" style="min-width: 250px;">Detail Nama Kategori</th>
                            <th class="text-center py-3" style="width: 200px;">Jumlah Berita Terkait</th>
                            <th class="text-center py-3" style="width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center py-5 bg-light text-muted">
                                    <div class="py-3">
                                        <i class="fa fa-folder-open-o fa-3x text-light-dark opacity-25 mb-3"
                                           aria-hidden="true"></i>
                                        <p class="mb-0 fw-semibold">Tidak ada data kategori yang tersedia.</p>
                                        <small class="text-muted">
                                            Silakan klik tombol "Tambah Kategori Baru" untuk mengisi
                                            data.
                                        </small>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <div class="fw-bold text-dark fs-6 mb-1">
                                            @item.NamaKategori
                                        </div>
                                        <div class="d-flex flex-wrap gap-2 text-muted small mt-1">
                                            <span class="d-flex align-items-center">
                                                <span class="badge bg-light text-secondary border rounded-1 me-1 px-1 py-0.5"
                                                      style="font-size: 0.7rem;">ID</span>
                                                <span class="text-truncate"
                                                      style="max-width: 200px;">@item.NamaKategori_ID</span>
                                            </span>
                                            <span class="text-black-50 d-none d-sm-inline">|</span>
                                            <span class="d-flex align-items-center">
                                                <span class="badge bg-light text-secondary border rounded-1 me-1 px-1 py-0.5"
                                                      style="font-size: 0.7rem;">EN</span>
                                                <span class="text-truncate"
                                                      style="max-width: 200px;">@item.NamaKategori_EN</span>
                                            </span>
                                        </div>
                                    </td>

                                    <td class="text-center py-3">
                                        @if (item.TotalNews > 0)
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-3 py-2 rounded-pill fw-bold">
                                                <i class="fa fa-newspaper-o me-1" aria-hidden="true"></i> @item.TotalNews Item
                                                Berita
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border px-3 py-2 rounded-pill small fw-normal">
                                                0 Berita
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center py-3 pe-4">
                                        <div class="btn-group shadow-sm rounded-2 overflow-hidden" role="group">
                                            <a asp-action="Edit" asp-route-id="@item.IDKategori"
                                               class="btn btn-warning btn-sm fw-semibold text-dark px-3 d-inline-flex align-items-center gap-1"
                                               title="Ubah Data Kategori">
                                                <i class="fa fa-pencil"></i> Edit
                                            </a>
                                            <button type="button" onclick="deleteKategori(@item.IDKategori)"
                                                    class="btn btn-danger btn-sm fw-semibold px-3 d-inline-flex align-items-center gap-1"
                                                    title="Hapus Kategori">
                                                <i class="fa fa-trash"></i> Hapus
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteKategori(id) {
            Swal.fire({
                title: 'Hapus Kategori?',
                text: "Pastikan tidak ada berita aktif yang sedang mengikat atau menggunakan relasi kategori ini.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Ya, Hapus Teratur',
                cancelButtonText: 'Batal',
                customClass: {
                    confirmButton: 'btn btn-danger px-3 mx-1',
                    cancelButton: 'btn btn-secondary px-3 mx-1'
                },
                buttonsStyling: false
            }).then((result) => {
                if (result.isConfirmed) {
                    // Tampilkan loading state sesaat sebelum AJAX dieksekusi
                    Swal.fire({
                        title: 'Memproses data...',
                        didOpen: () => { Swal.showLoading() },
                        allowOutsideClick: false
                    });

                    $.ajax({
                        url: '/Kategori/Delete/' + id,
                        type: 'POST',
                        success: function (res) {
                            if (res.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Terhapus!',
                                    text: 'Kategori berhasil disingkirkan dari sistem.',
                                    timer: 1500,
                                    showConfirmButton: false
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                Swal.fire('Gagal!', res.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Error!', 'Terjadi kegagalan komunikasi internal server.', 'error');
                        }
                    });
                }
            });
        }
    </script>

    <script>
        // Pemicu Notifikasi SweetAlert untuk TempData internal controller
        @if (TempData["SuccessMessage"] != null)
        {
            <text>
                            Swal.fire({
                                icon: 'success',
                            title: 'Aksi Berhasil!',
                            text: '@Html.Raw(TempData["SuccessMessage"])',
                            timer: 4000,
                            showConfirmButton: false,
                            toast: true,
                            position: 'top-end',
                            background: '#fff',
                            iconColor: '#198754'
                            });
            </text>
        }
    </script>
}